# Postgres (Prisma) — bisa reuse project Supabase yang sama dengan Director Assistant
# (tabel baru, prefix beda, tidak bentrok) atau project baru.
DATABASE_URL=
DIRECT_URL=

# WAHUB (WhatsApp gateway) — sama backend (WAHUB_BASE_URL) dengan Director Assistant, TAPI
# WAHUB_API_KEY di sini WAJIB sesi/nomor WA baru yang terpisah (bukan reuse punya Director
# Assistant) — satu sesi cuma bisa punya 1 webhook aktif, kalau dipakai bareng nanti saling
# menimpa & chat WA "Naya" di Director Assistant berhenti berfungsi. Lihat catatan di lib/wahub.ts.
WAHUB_BASE_URL=
WAHUB_API_KEY=
WAHUB_WEBHOOK_SECRET=
# JID grup WhatsApp internal untuk reminder harian/mingguan (format: xxxxx@g.us) — pastikan
# nomor WA sesi BARU di atas juga jadi anggota grup ini.
WAHUB_GROUP_JID=
# JID grup WA Marketing (terpisah dari grup ops) — tujuan alert "lead belum direspon > X menit".
# Nomor Director Assistant (WAHUB_BASE_URL) harus jadi anggota grup ini. Kosong = fitur mati.
MARKETING_WAHUB_GROUP_JID=

# Instance WAHUB TERPISAH khusus modul Marketing (backend-wahub-dewari) — dedicated, BUKAN reuse
# WAHUB_BASE_URL/WAHUB_API_KEY di atas (itu punya Director Assistant). Dapatkan API key dengan
# POST /api/admin/login (username/password admin instance ini) lalu POST /api/admin/clients
# {"name": "..."} — lihat lib/wahub.ts § "Session per-Sales".
MARKETING_WAHUB_BASE_URL=
MARKETING_WAHUB_API_KEY=

# URL publik app ini, dipakai di link laporan WA & registrasi webhook WAHUB
APP_BASE_URL=

# Claude (AI Agent — Fase 4)
ANTHROPIC_API_KEY=

# OpenAI Whisper — transkripsi rekaman panggilan lead (Marketing > Detail Lead > Rekam Panggilan)
OPENAI_API_KEY=

