LEGACY_SSH_HOST=157.15.77.84
LEGACY_SSH_USER=mmuachproject
LEGACY_SSH_PASSWORD=
LEGACY_DB_NAME=mmuachproject
LEGACY_DB_USER=sevensmarts
LEGACY_DB_PASSWORD=

