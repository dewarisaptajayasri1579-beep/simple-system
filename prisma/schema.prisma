generator client {
  provider = "prisma-client-js"
}

// Sengaja pakai Postgres schema terpisah ("simple_system") di project Supabase yang sama
// dengan Director Assistant, supaya nama tabel (users, sessions, transactions, dst) tidak
// bentrok dengan schema "public" milik Director Assistant yang sudah jalan duluan.
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["simple_system"]
}

// ---------------------------------------------------------------------------
// Auth & Role
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phoneNumber  String?   @map("phone_number")
  role         String    @default("admin") // "owner" | "direktur" | "admin"
  // Modul apa saja yang boleh diakses user ini — "internal" | "marketing" | "monitoring".
  // INDEPENDEN dari `role` di atas: role cuma menentukan detail izin DI DALAM modul Internal
  // (Kas Keluar saja, Buku Besar per-akun COA, dst — lihat diskusi role Admin), modules
  // menentukan modul mana yang bisa dimasuki sama sekali. Owner SELALU bisa akses semua modul
  // apa pun isi array ini (bypass, sama pola dengan isOwner check di tempat lain) — lihat
  // requireModuleAccess di lib/current-user.ts. Default cuma "internal" karena user lama
  // sebelum kolom ini ada semuanya staf Internal.
  modules      String[] @default(["internal"])
  // Nonaktif → tidak bisa login & sesi aktifnya dicabut, tapi semua riwayat (pesan, aktivitas,
  // audit, KPI) tetap utuh. Owner tidak boleh dinonaktifkan. Dikelola di Pengaturan → User.
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  // ---- Relasi modul Marketing (Simple Lead) — lihat docs/04-database.md. Reuse User yang
  // sudah ada (bukan tabel users terpisah) supaya 1 login = 1 identitas di semua modul; role
  // SALES/SPV/MEMBER per-team disimpan di TeamMembership.membershipRole, TERPISAH dari
  // User.role (owner/direktur/admin) di atas yang mengatur modul Internal.
  teamsManaged             Team[]                @relation("TeamManager")
  teamMemberships          TeamMembership[]      @relation("TeamMembershipUser")
  supervisedMemberships    TeamMembership[]      @relation("TeamMembershipSupervisor")
  leadSegmentChanges       LeadSegmentHistory[]
  leadTemperatureChanges   LeadTemperatureHistory[]
  leadAssignmentsReceived  LeadAssignment[]      @relation("LeadAssignmentAssignee")
  leadAssignmentsMade      LeadAssignment[]      @relation("LeadAssignmentAssignedBy")
  sentMessages             Message[]
  leadActivities           LeadActivity[]
  leadFollowUpsAssigned    LeadFollowUp[]        @relation("LeadFollowUpAssignee")
  leadFollowUpsCreated     LeadFollowUp[]        @relation("LeadFollowUpCreator")
  leadAiSuggestionsUsed    LeadAiSuggestion[]
  leadNotifications        LeadNotification[]
  pushSubscriptions        PushSubscription[]
  auditLogs                AuditLog[]
  leadSystemSettingsUpdated LeadSystemSetting[]
  whatsappConnection       WhatsappConnection?

  @@map("users")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Pengembangan Sistem — daftar fitur/perbaikan yang akan/sedang dikerjakan di
// aplikasi ini sendiri (bukan data operasional client). Semua role bisa lihat &
// tambah usulan; status cuma "belum"/"proses"/"selesai" (bukan Prisma enum,
// sama pola dengan Transaction.postStatus dkk).
// ---------------------------------------------------------------------------
model SystemDevelopmentItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("belum") // "belum" | "proses" | "selesai"
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("system_development_items")
  @@schema("simple_system")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Master data hasil migrasi dari aplikasi lama (lihat scripts/migrate-legacy.ts)
// ---------------------------------------------------------------------------

model Client {
  id                   String   @id @default(uuid())
  legacyId             Int?     @unique @map("legacy_id")
  legacySalesClientId  String?  @unique @map("legacy_sales_client_id") // link manual ke LegacySalesClient (dicocokkan belakangan)
  name        String
  email       String?
  phoneNumber String?  @map("phone_number")
  picName     String?  @map("pic_name")
  picPhone    String?  @map("pic_phone")
  city        String?
  address     String?
  notes       String?
  // Instansi pemerintah/badan yang berstatus Pemungut PPN — PPN atas invoice ke client ini
  // disetor LANGSUNG oleh client ke kas negara (bukti pungut), TIDAK ditransfer ke kita.
  // Efeknya: sisa tagih/lunas invoice dihitung dari DPP saja (totalAmount - ppnAmount), lihat
  // `invoiceCashDue` di lib/invoice-due.ts — jangan hitung ulang manual di tempat lain.
  isPemungutPpn Boolean @default(false) @map("is_pemungut_ppn")
  createdAt   DateTime @default(now()) @map("created_at")

  domains            Domain[]
  subdomains         Subdomain[]
  invoices           Invoice[]
  payments           Payment[]
  servers            Server[]
  maintenances       Maintenance[]
  projects           Project[]
  legacySalesClient  LegacySalesClient? @relation(fields: [legacySalesClientId], references: [id])

  @@map("clients")
  @@schema("simple_system")
}

/// Staging: 326 pelanggan mentah dari aplikasi penjualan lama (m_pelanggan, server .86) —
/// SENGAJA belum otomatis digabung ke tabel Client utama supaya bisa dicocokkan manual dulu
/// (banyak kemungkinan duplikat dengan 125 client hasil migrasi pertama). Client baru yang
/// dibuat otomatis saat migrasi piutang (karena Invoice butuh Client asli) tetap ditandai lewat
/// relasi legacySalesClientId di atas.
model LegacySalesClient {
  id           String   @id @default(uuid())
  legacyId     Int      @unique @map("legacy_id") // m_pelanggan.id
  kode         String?
  name         String   @map("namalengkap")
  phoneNumber  String?  @map("phone_number")
  address      String?
  bankName     String?  @map("bank_name")
  bankAccount  String?  @map("bank_account")
  paymentTermDays Int?  @map("payment_term_days")
  creditLimit  Float?   @map("credit_limit")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client?

  @@map("legacy_sales_clients")
  @@schema("simple_system")
}

model Vendor {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String
  website  String?

  servers        Server[]
  recurringBills RecurringBill[]

  @@map("vendors")
  @@schema("simple_system")
}

model BillingPeriod {
  id                 String @id @default(uuid())
  legacyId           Int?   @unique @map("legacy_id")
  name               String // "Bulanan", "Tahunan", "2 Tahunan", "3 Bulanan", "6 Bulanan"
  reminderDaysBefore Int    @map("reminder_days_before")

  servers        Server[]
  recurringBills RecurringBill[]
  maintenances   Maintenance[]

  @@map("billing_periods")
  @@schema("simple_system")
}

model CloudType {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String

  servers        Server[]
  cpanelAccounts CpanelAccount[]

  @@map("cloud_types")
  @@schema("simple_system")
}

model HostingPackage {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String

  cpanelAccounts CpanelAccount[]

  @@map("hosting_packages")
  @@schema("simple_system")
}

model Server {
  id                String    @id @default(uuid())
  legacyId          Int?      @unique @map("legacy_id")
  name              String
  ipAddress         String?   @map("ip_address")
  vendorId          String?   @map("vendor_id")
  cloudTypeId       String?   @map("cloud_type_id")
  clientId          String?   @map("client_id") // kosong = infra internal 7Smarts, terisi = disewakan ke client ini
  core              String?
  ram               String?
  storage           String?
  dnsServer1        String?   @map("dns_server_1")
  dnsServer2        String?   @map("dns_server_2")
  subscriptionStart DateTime? @map("subscription_start")
  billingDayOfMonth Int?      @map("billing_day_of_month")
  periodId          String?   @map("period_id")
  periodCount       Int?      @map("period_count")
  price             Float?
  lastPaidAt        DateTime? @map("last_paid_at")
  // "Tgl Berakhir" — acuan renewal resmi, sama peran dengan Domain.expiryDate: begitu dibayar,
  // INI yang dimajukan sesuai siklus periode (bukan lastPaidAt/tanggal bayar), supaya telat
  // bayar tidak menggeser siklus jatuh tempo berikutnya. Nullable — fallback ke
  // lastPaidAt+periode buat baris yang belum pernah kesetel (lihat resolveServerExpiry).
  expiryDate        DateTime? @map("expiry_date")
  lastCheckinAt     DateTime? @map("last_checkin_at")
  active            Boolean   @default(true)
  legacyActiveFlag  String?   @map("legacy_active_flag")

  vendor    Vendor?        @relation(fields: [vendorId], references: [id])
  cloudType CloudType?     @relation(fields: [cloudTypeId], references: [id])
  period    BillingPeriod? @relation(fields: [periodId], references: [id])
  client    Client?        @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([vendorId])
  @@index([cloudTypeId])
  @@index([periodId])
  @@map("servers")
  @@schema("simple_system")
}

/// Jasa maintenance berkala ke client (mis. maintenance website bulanan) — sisi pendapatan
/// (price, ditagihkan ke client) sama seperti Domain/Server, punya biaya modal (HPP) sendiri
/// yang ditandai lunas terpisah lewat "Bayar Maintenance" (lihat markMaintenancePaid).
model Maintenance {
  id          String    @id @default(uuid())
  name        String
  clientId    String    @map("client_id") // wajib — beda dari Domain/Server, maintenance selalu untuk client tertentu
  periodId    String?   @map("period_id")
  periodCount Int?      @map("period_count")
  price       Float?
  lastPaidAt  DateTime? @map("last_paid_at")
  // Bulan mulai kontrak maintenance ini — cuma bulan+tahun yang berarti (disimpan sebagai
  // tanggal 1 di bulan itu), murni informasi, TIDAK dipakai buat hitung jatuh tempo
  // (itu tetap dari lastPaidAt + periode, lihat computeNextDueDate).
  subscriptionStart DateTime? @map("subscription_start")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  client Client         @relation(fields: [clientId], references: [id])
  period BillingPeriod? @relation(fields: [periodId], references: [id])

  @@index([clientId])
  @@index([periodId])
  @@map("maintenances")
  @@schema("simple_system")
}

/// SLA tindak-lanjut tagihan (lihat sop.txt) — satu record = satu siklus tagihan buat Domain/
/// Server/Maintenance yang punya Client. refType/refId ikut pola polymorphic yang sama dengan
/// Transaction.refType/refId. Begitu paidRecordedAt terisi, siklus itu selesai; jatuh tempo
/// berikutnya bikin record baru (bukan reuse) — "record aktif" per (refType,refId) = yang
/// paidRecordedAt-nya masih null.
model BillingFollowUp {
  id        String  @id @default(uuid())
  refType   String  @map("ref_type") // "domain" | "server" | "maintenance" | "project_termin" | "invoice"
  refId     String  @map("ref_id")
  // Nullable — invoice manual & Project termin tidak lewat tahap "reminder muncul di Dashboard"
  // (langsung dibuat), siklusnya mulai langsung dari invoicedAt buat 2 jenis itu.
  dueAppearedAt DateTime? @map("due_appeared_at")
  invoicedAt    DateTime? @map("invoiced_at")
  invoicedById  String?   @map("invoiced_by_id") // null = auto-generate sistem (mis. cron Project termin)
  invoiceId     String?   @map("invoice_id")
  // Salinan "respon terakhir" (denormalized dari BillingFollowUpResponse terbaru) — dipakai
  // computeSlaStatus buat hitung tahap/deadline tanpa query tabel log tiap kali. Histori
  // lengkapnya ada di BillingFollowUpResponse (relasi responses di bawah).
  clientRespondedAt DateTime? @map("client_responded_at")
  promisedPayAt     DateTime? @map("promised_pay_at")
  paidRecordedAt    DateTime? @map("paid_recorded_at")
  paidRecordedById  String?   @map("paid_recorded_by_id")
  // Terisi kalau invoice yang nempel di siklus ini dibatalkan (Void) — invoicedAt/invoiceId
  // ikut direset ke null bareng ini (lihat POST /api/invoices/[id]/void) supaya siklusnya balik
  // ke tahap "perlu ditagih ulang" (bedain dari belum_ditagih yang benar-benar belum pernah
  // ditagih sama sekali — lihat computeSlaStatus di billing-follow-up.ts).
  voidedAt          DateTime? @map("voided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  responses BillingFollowUpResponse[]

  @@index([refType, refId])
  @@index([invoiceId])
  @@map("billing_follow_ups")
  @@schema("simple_system")
}

/// Log respon Client — 1 baris per kali staf input respon (bukan ditimpa), supaya histori
/// follow-up 1 piutang kelihatan lengkap (lihat Dashboard > Piutang). BillingFollowUp.
/// clientRespondedAt/promisedPayAt tetap disalin dari baris TERBARU di sini setiap kali ada
/// respon baru masuk, biar computeSlaStatus tidak perlu diubah.
model BillingFollowUpResponse {
  id                String   @id @default(uuid())
  billingFollowUpId String   @map("billing_follow_up_id")
  responseType      String   @map("response_type") // "sudah_bayar" | "janji_bayar" | "nego" | "tidak_respon" | "lainnya"
  note              String?
  promisedPayAt     DateTime? @map("promised_pay_at")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  billingFollowUp BillingFollowUp @relation(fields: [billingFollowUpId], references: [id], onDelete: Cascade)

  @@index([billingFollowUpId])
  @@map("billing_follow_up_responses")
  @@schema("simple_system")
}

model CpanelAccount {
  id          String  @id @default(uuid())
  legacyId    Int?    @unique @map("legacy_id")
  name        String
  username    String?
  password    String? // dimigrasi apa adanya (plaintext di sumber) — lihat catatan keamanan di plan
  cloudTypeId String? @map("cloud_type_id")
  packageId   String? @map("package_id")
  active      Boolean @default(true)

  cloudType CloudType?      @relation(fields: [cloudTypeId], references: [id])
  package   HostingPackage? @relation(fields: [packageId], references: [id])
  domains   Domain[]

  @@index([cloudTypeId])
  @@index([packageId])
  @@map("cpanel_accounts")
  @@schema("simple_system")
}

model Domain {
  id               String    @id @default(uuid())
  legacyId         Int?      @unique @map("legacy_id")
  name             String
  clientId         String?   @map("client_id")
  cpanelAccountId  String?   @map("cpanel_account_id")
  sellPrice        Float?    @map("sell_price")
  activatedAt      DateTime? @map("activated_at")
  lastPaidAt       DateTime? @map("last_paid_at")
  // Tanggal acuan renewal — kalau dibayar, INI yang ditambah 1 tahun (bukan lastPaidAt),
  // supaya telat bayar tidak menggeser siklus jatuh tempo tahun depan (lihat
  // finalizeTransactionPosting di mark-paid.ts). lastPaidAt murni catatan "kapan terakhir
  // dibayar"; expiryDate murni "kapan servicenya berakhir" — dua hal beda yang dulu digabung.
  expiryDate       DateTime? @map("expiry_date")
  active           Boolean   @default(true)
  legacyActiveFlag String?   @map("legacy_active_flag")
  createdAt        DateTime  @default(now()) @map("created_at")

  client        Client?        @relation(fields: [clientId], references: [id])
  cpanelAccount CpanelAccount? @relation(fields: [cpanelAccountId], references: [id])
  subdomains    Subdomain[]

  @@index([clientId])
  @@index([cpanelAccountId])
  @@map("domains")
  @@schema("simple_system")
}

model Subdomain {
  id               String    @id @default(uuid())
  legacyId         Int?      @unique @map("legacy_id")
  domainId         String?   @map("domain_id")
  name             String
  clientId         String?   @map("client_id")
  sellPrice        Float?    @map("sell_price")
  activatedAt      DateTime? @map("activated_at")
  lastPaidAt       DateTime? @map("last_paid_at")
  legacyActiveFlag String?   @map("legacy_active_flag")

  domain Domain? @relation(fields: [domainId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@index([domainId])
  @@index([clientId])
  @@map("subdomains")
  @@schema("simple_system")
}

model RecurringBill {
  id                String    @id @default(uuid())
  legacyId          Int?      @unique @map("legacy_id")
  name              String
  identifier        String?   @map("identifier") // Nomor ID / Keterangan (mis. nomor pelanggan PLN, ID akun, dsb)
  vendorId          String?   @map("vendor_id")
  category          String    @default("kantor") // "kantor" | "pribadi" | "lainnya"
  subscriptionStart DateTime? @map("subscription_start")
  billingDayOfMonth Int?      @map("billing_day_of_month")
  periodId          String?   @map("period_id")
  periodCount       Int?      @map("period_count")
  // Cuma relevan kalau period-nya "Mingguan" — hari dalam seminggu biaya ini biasa dibayar
  // (1=Senin .. 7=Minggu, sama konvensi dengan jakartaIsoWeekday di lib/datetime.ts). Murni info
  // buat staf, tidak dipakai hitung jatuh tempo (itu tetap dari lastPaidAt + periode).
  payDayOfWeek      Int?      @map("pay_day_of_week")
  price             Float?
  lastPaidAt        DateTime? @map("last_paid_at")
  lastCheckinAt     DateTime? @map("last_checkin_at") // kapan terakhir ditanya "sudah dibayar?" via WA
  active            Boolean   @default(true)

  vendor Vendor?        @relation(fields: [vendorId], references: [id])
  period BillingPeriod? @relation(fields: [periodId], references: [id])

  @@index([vendorId])
  @@index([periodId])
  @@map("recurring_bills")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Penjualan / Invoicing — mekanisme Piutang
// ---------------------------------------------------------------------------

model Item {
  id           String  @id @default(uuid())
  legacyId     Int?    @unique @map("legacy_id") // dari m_jasa aplikasi penjualan lama (server .86)
  name         String
  type         String  @default("jasa") // "jasa" | "barang"
  defaultPrice Float   @default(0) @map("default_price")
  defaultCost  Float   @default(0) @map("default_cost")
  unit         String?
  active       Boolean @default(true)

  invoiceLines InvoiceLine[]

  @@map("items")
  @@schema("simple_system")
}

model Invoice {
  id            String   @id @default(uuid())
  legacyId      String?  @unique @map("legacy_id") // id (UUID) t_penjualan aplikasi penjualan lama, buat piutang migrasi
  invoiceNumber String   @unique @map("invoice_number")
  clientId      String   @map("client_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  dueDate       DateTime? @map("due_date")
  subtotal      Float    @default(0)
  discountAmount Float   @default(0) @map("discount_amount")
  ppnEnabled    Boolean  @default(false) @map("ppn_enabled")
  ppnRate       Float    @default(11) @map("ppn_rate")
  ppnAmount     Float    @default(0) @map("ppn_amount")
  totalAmount   Float    @default(0) @map("total_amount")
  totalCost     Float    @default(0) @map("total_cost")
  status        String   @default("unpaid") // "unpaid" | "partial" | "paid" | "claimed_paid"
  notes         String?

  // Arsip bukti setor PPN oleh client Pemungut PPN (mis. instansi pemerintah) — CATATAN saja,
  // tidak ada efek jurnal (PPN-nya memang tidak pernah masuk kas kita, lihat Client.isPemungutPpn
  // dan invoiceCashDue di lib/invoice-due.ts). Diisi manual, boleh kosong walau client-nya
  // pemungut (bukti belum diterima) — tidak menghalangi invoice ditandai lunas di DPP.
  noBuktiPungutPpn  String?   @map("no_bukti_pungut_ppn")
  tglBuktiPungutPpn DateTime? @map("tgl_bukti_pungut_ppn")

  // DP yang DISEPAKATI/direncanakan (mis. dinas janji bayar DP dulu) — CATATAN saja, sama pola
  // dengan noBuktiPungutPpn/Piutang Termin Project: TIDAK ADA efek kas/jurnal, karena uangnya
  // belum benar-benar masuk. Beda dari pelunasan asli (InvoicePayment, lewat menu Pembayaran)
  // yang baru itu jurnal Kas/Bank + Pendapatan. Dipakai buat tampilkan estimasi "Sisa Setelah DP"
  // di invoice cetak SEBELUM ada uang masuk sama sekali — begitu ada InvoicePayment asli, nota
  // beralih pakai angka pelunasan asli (lihat NotaPrintable), bukan dpAmount ini lagi.
  dpAmount Float @default(0) @map("dp_amount")
  lastFollowUpAt DateTime? @map("last_follow_up_at") // kapan terakhir AI Agent follow-up ke Client
  createdAt     DateTime @default(now()) @map("created_at")

  // Null = perilaku default (posting ke COA_CODE.pendapatanJasa saat dibayar, lihat
  // invoicePaymentLines). Diisi eksplisit oleh sumber invoice tertentu (mis. auto-generate
  // termin Project) yang pendapatannya harus masuk ke akun revenue lain dari Pendapatan Jasa.
  revenueCoaCode String? @map("revenue_coa_code")

  // Kalau invoice ini dibuat dari tombol "Tagih Sekarang" di Dashboard (Domain/Server), simpan
  // domain/server yang dimaksud di sini — dipakai form Pembayaran buat otomatis pilih "Bayar
  // Domain/Server" + itemnya begitu invoice ini dilunasi, staf tidak perlu pilih manual lagi.
  costLinkType String? @map("cost_link_type") // "domain" | "server"
  costLinkId   String? @map("cost_link_id")

  // Siapa yang input invoice ini (beda dari postedById/voidedById di bawah — itu siapa yang
  // posting/batalkan, bisa orang lain). Nullable karena baris lama (sebelum kolom ini ada) tidak
  // di-backfill.
  createdById String? @map("created_by_id")

  // Draft -> Posted -> (Voided): efek invoice (masuk Piutang, jurnal HPP kalau ada) baru
  // berlaku setelah posted. Terpisah dari `status` di atas (itu status pelunasan, bukan ini).
  // Voided = salah input setelah posting — dibatalkan (bukan dihapus), efeknya hilang dari
  // Piutang/laporan tapi tetap kelihatan di riwayat dengan badge "Dibatalkan".
  postStatus  String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt    DateTime? @map("posted_at")
  postedById  String?   @map("posted_by_id")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id")
  voidReason  String?   @map("void_reason")

  client   Client           @relation(fields: [clientId], references: [id])
  lines    InvoiceLine[]
  payments InvoicePayment[]
  projectPaymentSchedule ProjectPaymentSchedule?

  @@index([clientId])
  @@map("invoices")
  @@schema("simple_system")
}

model InvoiceLine {
  id             String @id @default(uuid())
  invoiceId      String @map("invoice_id")
  itemId         String? @map("item_id")
  description    String
  qty            Float  @default(1)
  unitPrice      Float  @map("unit_price")
  unitCost       Float  @default(0) @map("unit_cost")
  discountAmount Float  @default(0) @map("discount_amount")
  lineTotal      Float  @map("line_total")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_lines")
  @@schema("simple_system")
}

model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  accountId     String   @map("account_id")
  paymentId     String?  @map("payment_id") // grup ke kwitansi Payment (menu Pembayaran) — null utk payment lama/migrasi
  amount        Float
  costAmount    Float    @default(0) @map("cost_amount") // HPP tambahan yang diinput manual saat transaksi ini (di luar HPP baris invoice)
  paidAt        DateTime @default(now()) @map("paid_at")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  transactionId String?  @unique @map("transaction_id")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([invoiceId])
  @@index([accountId])
  @@index([paymentId])
  @@map("invoice_payments")
  @@schema("simple_system")
}

/// Kwitansi pembayaran (menu Pembayaran) — satu Payment bisa melunasi/mencicil beberapa
/// Invoice milik 1 Client sekaligus, tiap Invoice yang dibayar tercatat sbg 1 InvoicePayment.
model Payment {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number") // PMT/{tahun}/{5 digit berurut}
  clientId      String   @map("client_id")
  accountId     String   @map("account_id")
  totalAmount   Float    @map("total_amount")
  notes         String?
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Siapa yang input Payment ini — lihat catatan createdById di Invoice.
  createdById String? @map("created_by_id")

  // Draft -> Posted -> (Voided): piutang belum berkurang & saldo kas belum bergerak sampai
  // posted. Voided = dibatalkan setelah posting karena salah input, lihat catatan di Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  client          Client           @relation(fields: [clientId], references: [id])
  account         Account          @relation(fields: [accountId], references: [id])
  invoicePayments InvoicePayment[]
  revenueSlot     RevenueSlot?

  @@index([clientId])
  @@index([accountId])
  @@map("payments")
  @@schema("simple_system")
}

/// Project development dengan pembayaran termin (DP/Termin 1/dst) — lihat ProjectPaymentSchedule.
/// "Nilai Total" & "Sisa Tagih" sengaja tidak disimpan di sini, dihitung dari schedules/invoice
/// supaya tidak ada dua sumber kebenaran yang bisa desinkron.
model Project {
  id        String    @id @default(uuid())
  name      String
  clientId  String    @map("client_id")
  picName   String?   @map("pic_name")
  picPhone  String?   @map("pic_phone")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  status    String    @default("berjalan") // "berjalan" | "selesai" | "batal"
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")

  client    Client                   @relation(fields: [clientId], references: [id])
  schedules ProjectPaymentSchedule[]

  @@index([clientId])
  @@map("projects")
  @@schema("simple_system")
}

/// 1 baris = 1 termin pembayaran project (DP, Termin 1, dst). Invoice-nya auto-generate H-3
/// sebelum dueDate (lihat src/lib/cron/project-termin-invoicing.ts) atau manual lewat tombol
/// "Generate Invoice Sekarang" — begitu invoiceId terisi, nominal harus diubah lewat Invoice-nya
/// langsung, bukan di sini. "Nominal Dibayar"/"Sisa Tagih" dihitung dari invoice.payments, tidak
/// disimpan (piutang termin = catatan/computed saja, bukan akun GL — lihat journal-rules.ts).
model ProjectPaymentSchedule {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  label              String    // "DP", "Termin 1", "Termin 2", dst — bebas diketik
  sortOrder          Int       @default(0) @map("sort_order")
  dueDate            DateTime  @map("due_date") // Tgl Penagihan
  amount             Float     @map("amount")    // Nominal Tagih
  invoiceId          String?   @unique @map("invoice_id")
  invoiceGeneratedAt DateTime? @map("invoice_generated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([projectId])
  @@map("project_payment_schedules")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Keuangan
// ---------------------------------------------------------------------------

model Account {
  id             String   @id @default(uuid())
  name           String
  type           String   // "kas" | "bank"
  bankName       String?  @map("bank_name")
  accountNumber  String?  @map("account_number")
  openingBalance Float    @default(0) @map("opening_balance")
  coaAccountId   String?  @map("coa_account_id")
  createdAt      DateTime @default(now()) @map("created_at")

  transactions       Transaction[]
  invoicePayments    InvoicePayment[]
  payments           Payment[]
  coaAccount         ChartOfAccount?   @relation(fields: [coaAccountId], references: [id])
  transfersOut       AccountTransfer[] @relation("AccountTransferSource")
  transfersIn        AccountTransfer[] @relation("AccountTransferDestination")

  // Akun ini dipilih sebagai salah satu dari 4 tujuan Slotting Omset di Settings (0-1 baris
  // masing-masing, karena Settings singleton) — lihat catatan di model Settings/RevenueSlot.
  slottingOperasionalFor Settings? @relation("SlottingOperasionalAccount")
  slottingDireksiFor     Settings? @relation("SlottingDireksiAccount")
  slottingBonusFor       Settings? @relation("SlottingBonusAccount")
  slottingHppReserveFor  Settings? @relation("SlottingHppReserveAccount")

  @@index([coaAccountId])
  @@map("accounts")
  @@schema("simple_system")
}

model Category {
  id           String  @id @default(uuid())
  name         String
  kind         String  // "income" | "expense" | "hpp"
  coaAccountId String? @map("coa_account_id")

  transactions Transaction[]
  coaAccount   ChartOfAccount? @relation(fields: [coaAccountId], references: [id])

  @@index([coaAccountId])
  @@map("categories")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Akuntansi Akrual: Chart of Accounts + Jurnal Umum (double-entry)
// Berjalan berdampingan dengan pencatatan cash-basis di atas — TIDAK
// menggantikan Transaction/InvoicePayment, cuma menambah jurnal debit/kredit
// otomatis di titik yang sama. Lihat src/lib/accounting/.
// ---------------------------------------------------------------------------

model ChartOfAccount {
  id        String   @id @default(uuid())
  code      String   @unique // "1-1001", "4-1000", dst — menentukan urutan tampil
  name      String
  type      String   // "asset" | "liability" | "equity" | "revenue" | "cogs" | "expense"
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  isParent  Boolean  @default(false) @map("is_parent") // kalau true, akun ini boleh ditambahi sub-akun (anak)
  createdAt DateTime @default(now()) @map("created_at")

  parent       ChartOfAccount?  @relation("COAHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("COAHierarchy")
  journalLines JournalLine[]
  accounts     Account[]
  categories   Category[]
  roleAccess   RoleCoaAccess[]

  @@index([parentId])
  @@map("chart_of_accounts")
  @@schema("simple_system")
}

/// Daftar akun COA yang boleh dilihat 1 role tertentu di Akuntansi > Buku Besar (lihat Pengaturan
/// > Akses COA per Role) — cuma dipakai buat role yang DIBATASI (role "admin"), Owner/Direktur
/// selalu bebas lihat semua akun tanpa perlu baris di tabel ini. Kalau role tidak punya baris
/// sama sekali di sini, dianggap belum di-set (bukan berarti "boleh semua" atau "tidak boleh
/// sama sekali") — lihat guard di app/akuntansi/buku-besar/page.tsx.
model RoleCoaAccess {
  id           String   @id @default(uuid())
  role         String // "admin" — role lain (owner/direktur) tidak butuh baris di sini
  coaAccountId String   @map("coa_account_id")
  createdAt    DateTime @default(now()) @map("created_at")

  coaAccount ChartOfAccount @relation(fields: [coaAccountId], references: [id], onDelete: Cascade)

  @@unique([role, coaAccountId])
  @@map("role_coa_access")
  @@schema("simple_system")
}

model JournalEntry {
  id          String   @id @default(uuid())
  entryNumber String   @unique @map("entry_number") // "JE-2026-000001"
  date        DateTime
  description String
  sourceType  String   @map("source_type") // "invoice" | "invoice_revenue" | "invoice_payment" | "transaction" | "recurring_bill" | "server" | "domain" | "manual" | "correction"
  sourceId    String?  @map("source_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Draft -> Posted -> (Voided): baris jurnal bisa ditinjau/diedit selama draft, tidak masuk
  // hitungan laporan/saldo/buku besar sampai posted, dan terkunci begitu posted. Voided =
  // dibatalkan setelah posting karena salah input (tetap tampil di Jurnal Umum dgn badge,
  // tapi tidak dihitung di saldo/laporan manapun) — lihat catatan di model Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  lines           JournalLine[]
  transaction     Transaction?
  accountTransfer AccountTransfer?

  @@index([sourceType, sourceId])
  @@map("journal_entries")
  @@schema("simple_system")
}

model JournalLine {
  id             String @id @default(uuid())
  journalEntryId String @map("journal_entry_id")
  accountId      String @map("account_id")
  debit          Float  @default(0)
  credit         Float  @default(0)
  memo           String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
  @@schema("simple_system")
}

model Transaction {
  id                  String   @id @default(uuid())
  // Nomor bukti kas keluar/masuk — BKK/{tahun}/{5 digit urut} (expense) atau
  // BKM/{tahun}/{5 digit urut} (income), sama pola dengan Payment.paymentNumber (PMT) &
  // Invoice.invoiceNumber (INV). Nullable karena baris lama (sebelum kolom ini ada) tidak
  // di-backfill.
  transactionNumber   String?  @unique @map("transaction_number")
  accountId           String   @map("account_id")
  type                String   // "income" | "expense"
  categoryId          String?  @map("category_id")
  grossAmount         Float    @map("gross_amount")
  cost                Float    @default(0)
  netAmount           Float    @map("net_amount")
  splitOperasionalPct Float?   @map("split_operasional_pct")
  splitDireksiPct     Float?   @map("split_direksi_pct")
  splitBonusPct       Float?   @map("split_bonus_pct")
  operasionalAmount   Float?   @map("operasional_amount")
  direksiAmount       Float?   @map("direksi_amount")
  bonusAmount         Float?   @map("bonus_amount")
  description         String?
  occurredAt          DateTime @default(now()) @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")

  // Siapa yang input Transaction ini — lihat catatan createdById di Invoice.
  createdById String? @map("created_by_id")

  // Draft -> Posted -> (Voided): saldo akun belum bergerak sampai posted (lihat
  // computeAccountBalance). Voided = dibatalkan setelah posting, lihat catatan di Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  // Referensi balik opsional ke Server/Domain/RecurringBill kalau Transaction ini hasil
  // "Bayar Server/Domain"/"Tandai Lunas" — dipakai endpoint posting utk tahu lastPaidAt
  // milik record mana yang perlu diupdate saat Transaction ini di-posting.
  refType String? @map("ref_type") // "server" | "domain" | "recurring_bill" | "maintenance"
  refId   String? @map("ref_id")

  // Kalau Transaction ini dibuat sebagai bagian dari 1 Payment (baris pelunasan invoice ATAU
  // costLink Bayar Domain/Server yang dikaitkan ke pembayaran itu) — dipakai
  // POST /api/payments/[id]/post utk tahu Transaction mana saja yang perlu ikut diposting.
  paymentId String? @map("payment_id")

  // Link presisi ke JournalEntry yang dibuat BARENGAN transaksi ini (bukan lookup by
  // sourceType+sourceId — itu sengaja dipakai bareng-bareng oleh SEMUA histori pembayaran
  // domain/server yang sama, jadi kalau dipakai buat "Lihat Jurnal" 1 transaksi tertentu bisa
  // kebawa jurnal punya transaksi lain/lama yang sudah dibatalkan). Nullable karena baris lama
  // (sebelum kolom ini ada) belum kesetel.
  journalEntryId String? @unique @map("journal_entry_id")

  account        Account         @relation(fields: [accountId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  invoicePayment InvoicePayment?
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([accountId])
  @@index([categoryId])
  @@index([paymentId])
  @@index([refType, refId])
  @@map("transactions")
  @@schema("simple_system")
}

// Pindah Buku — pemindahan saldo antar akun kas/bank sendiri (bukan pendapatan/beban), mis.
// tarik tunai ATM (Bank -> Kas) atau setor tunai (Kas -> Bank). Sengaja model terpisah dari
// Transaction (bukan overload type="transfer") karena butuh 2 accountId sekaligus (sumber +
// tujuan), beda bentuk dari Transaction yang cuma 1 accountId + kategori. Draft -> Posted ->
// (Voided) sama persis polanya dengan Transaction — jurnal dibuat draft bareng record ini,
// baru berlaku (masuk saldo/laporan) begitu di-posting.
model AccountTransfer {
  id                    String   @id @default(uuid())
  // Nomor bukti — BPB/{tahun}/{5 digit urut}, sama pola dengan BKK/BKM (transaction-number.ts).
  transferNumber        String?  @unique @map("transfer_number")
  sourceAccountId       String   @map("source_account_id")
  destinationAccountId  String   @map("destination_account_id")
  amount                Float
  description           String?
  occurredAt            DateTime @default(now()) @map("occurred_at")
  createdAt             DateTime @default(now()) @map("created_at")

  // Siapa yang input Pindah Buku ini — lihat catatan createdById di Invoice.
  createdById String? @map("created_by_id")

  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  // Sama pola dengan Transaction.journalEntryId — link presisi ke JournalEntry yang dibuat
  // bareng record ini, bukan lookup by sourceType+sourceId.
  journalEntryId String? @unique @map("journal_entry_id")

  // Terisi kalau AccountTransfer ini dibuat otomatis oleh proses "Slotting Omset" (bukan Pindah
  // Buku manual biasa) — lihat model RevenueSlot. Nullable karena mayoritas AccountTransfer
  // tetap manual.
  revenueSlotId String? @map("revenue_slot_id")

  sourceAccount      Account      @relation("AccountTransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account      @relation("AccountTransferDestination", fields: [destinationAccountId], references: [id])
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id])
  revenueSlot        RevenueSlot? @relation(fields: [revenueSlotId], references: [id])

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([revenueSlotId])
  @@map("account_transfers")
  @@schema("simple_system")
}

model Settings {
  id                String   @id @default("default")
  operasionalPct    Float    @default(40) @map("operasional_pct")
  direksiPct        Float    @default(50) @map("direksi_pct")
  bonusPct          Float    @default(10) @map("bonus_pct")
  defaultPpnRate    Float    @default(11) @map("default_ppn_rate")
  aiFollowUpEnabled Boolean  @default(false) @map("ai_follow_up_enabled")

  // Rekening tujuan transfer yang dicetak di Nota Invoice — beda rekening tergantung invoice-nya
  // pakai PPN atau tidak (lihat "Payment To" di format nota lama).
  paymentBankNamePpn       String? @map("payment_bank_name_ppn")
  paymentAccountNamePpn    String? @map("payment_account_name_ppn")
  paymentAccountNumberPpn  String? @map("payment_account_number_ppn")
  paymentBankNameNonPpn      String? @map("payment_bank_name_non_ppn")
  paymentAccountNameNonPpn   String? @map("payment_account_name_non_ppn")
  paymentAccountNumberNonPpn String? @map("payment_account_number_non_ppn")

  // ---- Slotting Omset — pembagian Laba Bersih Project (Uang Masuk - HPP) ke 4 rekening tujuan,
  // TERPISAH dari operasionalPct/direksiPct/bonusPct di atas (itu split lama per-baris pembayaran,
  // tanpa cadangan HPP, tidak pernah memindahkan uang beneran). Total 4 persentase di bawah harus
  // 100 (divalidasi di PATCH /api/settings). Akun tujuan nullable — "Proses" di menu Slotting
  // Omset ditolak kalau ada yang belum di-set.
  slottingOperasionalPct       Float   @default(40) @map("slotting_operasional_pct")
  slottingDireksiPct           Float   @default(40) @map("slotting_direksi_pct")
  slottingBonusPct             Float   @default(5)  @map("slotting_bonus_pct")
  slottingHppReservePct        Float   @default(15) @map("slotting_hpp_reserve_pct")
  slottingOperasionalAccountId String? @unique @map("slotting_operasional_account_id")
  slottingDireksiAccountId     String? @unique @map("slotting_direksi_account_id")
  slottingBonusAccountId       String? @unique @map("slotting_bonus_account_id")
  slottingHppReserveAccountId  String? @unique @map("slotting_hpp_reserve_account_id")
  // Biaya admin bank otomatis kalau akun sumber & tujuan beda bank (dipotong dari nominal yang
  // ditransfer, dicatat terpisah sebagai Transaction beban "Biaya Admin Bank" dari akun sumber).
  slottingTransferFee          Float   @default(2500) @map("slotting_transfer_fee")

  updatedAt         DateTime @updatedAt @map("updated_at")

  slottingOperasionalAccount Account? @relation("SlottingOperasionalAccount", fields: [slottingOperasionalAccountId], references: [id])
  slottingDireksiAccount     Account? @relation("SlottingDireksiAccount", fields: [slottingDireksiAccountId], references: [id])
  slottingBonusAccount       Account? @relation("SlottingBonusAccount", fields: [slottingBonusAccountId], references: [id])
  slottingHppReserveAccount  Account? @relation("SlottingHppReserveAccount", fields: [slottingHppReserveAccountId], references: [id])

  @@map("settings")
  @@schema("simple_system")
}

/// "Slotting Omset" — pembagian Laba Bersih 1 Payment (Uang Masuk - HPP yang sudah diinput -
/// biaya tambahan) ke 4 rekening tujuan (Operasional/Direksi/Bonus/Cadangan HPP), dieksekusi
/// lewat Pindah Buku (AccountTransfer) otomatis. Dibuat draft OTOMATIS begitu Payment
/// diposting (lihat POST /api/payments/[id]/post) — staf review & boleh tambah baris biaya dulu
/// (kalau ternyata ada biaya lain di luar yang sudah diinput saat pembayaran) sebelum klik
/// "Proses". 1 Payment cuma boleh punya 1 RevenueSlot (unique paymentId).
model RevenueSlot {
  id                    String    @id @default(uuid())
  paymentId             String    @unique @map("payment_id")
  // Disalin dari Payment.totalAmount saat draft dibuat — sengaja disalin (bukan selalu
  // dereference ulang ke Payment), sama pola dengan Transaction.grossAmount, supaya tetap akurat
  // walau ada perubahan lain di kemudian hari.
  grossAmount           Float     @map("gross_amount")
  // SUM(Transaction.cost) dari semua Transaction terkait Payment ini — HPP (+ proporsi PPN) yang
  // SUDAH dipotong saat pembayaran diinput (lihat computeSplit di payments/route.ts). Bukan cuma
  // HPP murni, tapi itu juga basis yang sama dipakai netAmount Transaction, supaya konsisten.
  initialCostAmount     Float     @map("initial_cost_amount")
  // Cache SUM(costLines.amount) — dihitung ulang tiap baris biaya ditambah/dihapus, supaya list
  // tidak perlu agregat ulang tiap render.
  additionalCostAmount  Float     @default(0) @map("additional_cost_amount")
  // netAmount & split amounts semuanya NULL sampai "Proses" (status masih draft) — dihitung FINAL
  // saat itu juga (bukan live di draft), supaya kalau baris biaya masih berubah-ubah, angka lama
  // tidak menyesatkan.
  netAmount             Float?    @map("net_amount")
  operasionalPct        Float?    @map("operasional_pct")
  direksiPct            Float?    @map("direksi_pct")
  bonusPct              Float?    @map("bonus_pct")
  hppReservePct         Float?    @map("hpp_reserve_pct")
  operasionalAmount     Float?    @map("operasional_amount")
  direksiAmount         Float?    @map("direksi_amount")
  bonusAmount           Float?    @map("bonus_amount")
  hppReserveAmount      Float?    @map("hpp_reserve_amount")
  transferFeeTotal      Float?    @map("transfer_fee_total")
  status                String    @default("draft") @map("status") // "draft" | "processed" | "skipped"
  createdAt             DateTime  @default(now()) @map("created_at")
  // Kapan draft ini "selesai" — baik lewat Proses (status=processed, transfer beneran dibuat)
  // maupun ditandai Tidak Split (status=skipped, sengaja tidak ada transfer sama sekali, mis.
  // payment internal/non-project yang tidak perlu dibagi). Nama field tetap "processed" biar
  // konsisten histori (bukan berarti proses split terjadi kalau statusnya skipped).
  processedAt           DateTime? @map("processed_at")
  processedById         String?   @map("processed_by_id")

  payment   Payment               @relation(fields: [paymentId], references: [id])
  costLines RevenueSlotCostLine[]
  transfers AccountTransfer[]

  @@index([status])
  @@map("revenue_slots")
  @@schema("simple_system")
}

/// Baris biaya TAMBAHAN yang ditemukan staf saat proses Slotting Omset (di luar biaya yang
/// sudah diinput saat pembayaran) — bisa lebih dari 1 baris, bebas deskripsi bebas.
model RevenueSlotCostLine {
  id            String   @id @default(uuid())
  revenueSlotId String   @map("revenue_slot_id")
  description   String
  amount        Float
  createdAt     DateTime @default(now()) @map("created_at")

  revenueSlot RevenueSlot @relation(fields: [revenueSlotId], references: [id], onDelete: Cascade)

  @@index([revenueSlotId])
  @@map("revenue_slot_cost_lines")
  @@schema("simple_system")
}

model FollowUp {
  id           String   @id @default(uuid())
  subject      String
  note         String
  followUpDate DateTime @map("follow_up_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("follow_ups")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// AI Agent (Fase 4)
// ---------------------------------------------------------------------------

model WhatsappThread {
  id         String   @id @default(uuid())
  senderType String   @map("sender_type") // "staff" | "client"
  userId     String?  @map("user_id")
  clientId   String?  @map("client_id")
  history    Json
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([senderType, userId])
  @@unique([senderType, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("whatsapp_threads")
  @@schema("simple_system")
}

model AgentRun {
  id          String   @id @default(uuid())
  actorType   String   @map("actor_type") // "staff" | "client"
  actorId     String   @map("actor_id")
  command     String
  agentAction String   @map("agent_action")
  result      String?
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("agent_runs")
  @@schema("simple_system")
}

/// Log khusus tiap kali AI Agent menonaktifkan domain/server/biaya berkala lewat WA — supaya
/// gampang diaudit siapa nonaktifin apa, terpisah dari AgentRun yang isinya semua jenis aksi.
model DeactivationLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") // "domain" | "server" | "recurring_bill"
  entityName String   @map("entity_name")
  actorId    String   @map("actor_id") // User.id kalau staf terdaftar, kalau tidak nomor WA mentah
  actorName  String   @map("actor_name")
  reason     String // alasan nonaktif, wajib diisi pengguna sebelum tool dieksekusi
  command    String // pesan asli yang memicu aksi ini
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("deactivation_logs")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Marketing — "Simple Lead" (lead management berbasis WhatsApp: inbox, follow up,
// priority engine, AI analysis). Spesifikasi lengkap ada di docs/01-project-overview.md
// s.d. docs/06-business-rule.md — schema di bawah mengikuti docs/04-database.md field-by-
// field. Sengaja TIDAK pakai Prisma `enum` (konsisten dengan seluruh schema di atas): semua
// nilai enum-like disimpan sebagai String + komentar daftar nilai yang valid, supaya
// perubahan pilihan tidak butuh migration.
// ---------------------------------------------------------------------------

model Team {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  managerUserId String?  @map("manager_user_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  managerUser User?            @relation("TeamManager", fields: [managerUserId], references: [id])
  memberships TeamMembership[]

  @@index([managerUserId])
  @@map("teams")
  @@schema("simple_system")
}

/// Mendukung user pindah team + histori. `membershipRole` (SALES/SPV/MEMBER) terpisah dari
/// User.role (owner/direktur/admin) — lihat catatan di model User.
model TeamMembership {
  id                 String    @id @default(uuid())
  teamId             String    @map("team_id")
  userId             String    @map("user_id")
  membershipRole     String    @map("membership_role") // "SALES" | "SPV" | "MEMBER"
  supervisorUserId   String?   @map("supervisor_user_id")
  activeFrom         DateTime  @default(now()) @map("active_from")
  activeUntil        DateTime? @map("active_until")
  isPrimary          Boolean   @default(true) @map("is_primary")
  createdAt          DateTime  @default(now()) @map("created_at")

  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User  @relation("TeamMembershipUser", fields: [userId], references: [id])
  supervisorUser User? @relation("TeamMembershipSupervisor", fields: [supervisorUserId], references: [id])

  @@index([teamId])
  @@index([userId])
  @@index([supervisorUserId])
  @@map("team_memberships")
  @@schema("simple_system")
}

/// Master produk/segmentasi (SevenRent, SAP, dst) — BUKAN indikator kualitas lead, itu
/// tugasnya Lead.temperature. Jangan hard delete segment yang pernah dipakai lead manapun.
model Segment {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  description          String?
  isActive             Boolean  @default(true) @map("is_active")
  defaultFollowUpHours Int?     @map("default_follow_up_hours")
  aiContext            String?  @map("ai_context")
  // Auto-segmentasi deterministik: kalau pesan masuk dari lead yang BELUM bersegmen mengandung
  // salah satu kata/frasa ini (whole-word, case-insensitive), lead langsung dimasukkan ke segmen
  // ini — dicek sebelum AI, jadi selalu menang atas tebakan AI. `keywordPriority` menentukan
  // pemenang kalau >1 segmen cocok (angka lebih besar = diprioritaskan).
  keywords             String[] @default([])
  keywordPriority      Int      @default(0) @map("keyword_priority")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  leads              Lead[]
  segmentHistoryFrom LeadSegmentHistory[] @relation("SegmentHistoryFrom")
  segmentHistoryTo   LeadSegmentHistory[] @relation("SegmentHistoryTo")

  @@map("segments")
  @@schema("simple_system")
}

model LeadSource {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  leads Lead[]

  @@map("lead_sources")
  @@schema("simple_system")
}

model LeadLostReason {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true) @map("is_active")

  leads Lead[]

  @@map("lead_lost_reasons")
  @@schema("simple_system")
}

/// Profiling kemampuan beli calon lead — sumbu TERPISAH dari `Segment` (jenis kebutuhan) dan
/// `temperature` (minat). Master data, bisa ditambah/nonaktifkan di Pengaturan Marketing →
/// Master Data. `priorityScoreEffect` = modifier flat (+/-) ke Priority Score (pola sama dengan
/// LeadFollowUpResultType.priorityScoreEffect, diterapkan sebagai modifier di priority.ts, BUKAN
/// komponen berbobot). `normalizedScore` disimpan buat dipakai nanti (mis. matriks minat×kapasitas).
model LeadBuyingPowerTier {
  id                  String  @id @default(uuid())
  code                String  @unique
  name                String
  description         String?
  sortOrder           Int     @default(0) @map("sort_order")
  normalizedScore     Int     @default(50) @map("normalized_score") // 0-100
  priorityScoreEffect Int     @default(0) @map("priority_score_effect")
  isActive            Boolean @default(true) @map("is_active")

  leads Lead[]

  @@map("lead_buying_power_tiers")
  @@schema("simple_system")
}

/// Core entity. `temperature`/`currentActivityStage`/`outcome` sengaja field terpisah (lihat
/// docs/04-database.md §1 & §7) — jangan pernah dipakai gantian satu sama lain (mis. "Closing"
/// bukan temperatur).
model Lead {
  id                     String    @id @default(uuid())
  displayName            String    @map("display_name")
  companyName            String?   @map("company_name")
  contactName            String?   @map("contact_name")
  whatsappNumber         String    @map("whatsapp_number")
  email                  String?
  city                   String?
  segmentId              String?   @map("segment_id")
  sourceId               String?   @map("source_id")
  // Profiling kemampuan beli (opsional, diisi manual Sales / saran AI nanti) — sumbu terpisah
  // dari segmen & temperatur. Lihat model LeadBuyingPowerTier.
  buyingPowerTierId      String?   @map("buying_power_tier_id")
  buyingPowerNote        String?   @map("buying_power_note")
  buyingPowerSource      String    @default("MANUAL") @map("buying_power_source") // "MANUAL" | "AI"
  temperature            String    @default("COLD") @map("temperature") // "COLD" | "WARM" | "HOT"
  temperatureSource      String    @default("MANUAL") @map("temperature_source") // "MANUAL" | "AI" | "RULE"
  outcome                String    @default("OPEN") // "OPEN" | "WON" | "LOST"
  currentActivityStage   String    @default("NONE") @map("current_activity_stage") // "NONE" | "DISCUSSION" | "ZOOM_DEMO" | "PROPOSAL" | "NEGOTIATION"
  priorityScore          Float     @default(0) @map("priority_score") // 0-100, lihat LeadPrioritySnapshot untuk breakdown
  priorityLevel          String    @default("LOW") @map("priority_level") // "LOW" | "MONITOR" | "HIGH" | "TOP"
  firstContactAt         DateTime  @default(now()) @map("first_contact_at")
  lastInteractionAt      DateTime? @map("last_interaction_at")
  lastCustomerMessageAt  DateTime? @map("last_customer_message_at")
  lastSalesMessageAt     DateTime? @map("last_sales_message_at")
  // Waktu pesan WA TERAKHIR di percakapan ini (masuk ATAU keluar) — dipakai buat sort "Chat
  // Terakhir" & kolom "Terakhir komunikasi" di daftar lead. Beda dari lastInteractionAt yang
  // ikut kegeser aktivitas internal / follow up.
  lastChatAt             DateTime? @map("last_chat_at")
  // Catatan singkat / pinned note per lead (freeform), tampil di daftar & detail.
  note                   String?
  // outcome WON wajib wonAt terisi, outcome LOST wajib lostAt terisi — divalidasi di service
  // layer (endpoint Won/Lost, lihat docs/04-database.md §28), bukan DB constraint.
  wonAt                  DateTime? @map("won_at")
  wonNote                String?   @map("won_note")
  dealValue              Int?      @map("deal_value") // nilai deal (Rupiah), diisi saat Tandai Won
  lostAt                 DateTime? @map("lost_at")
  lostReasonId           String?   @map("lost_reason_id")
  // AI tidak boleh auto-ubah temperatur selama lock ini aktif (docs/06 §6, manual override).
  temperatureLockedUntil DateTime? @map("temperature_locked_until")
  // Diisi saat lead ini sudah di-alert ke grup WA Marketing karena pesan customer belum dibalas;
  // di-reset null begitu Sales membalas → 1 alert per "episode belum dibalas" (anti-spam).
  waGroupAlertedAt       DateTime? @map("wa_group_alerted_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  segment        Segment?             @relation(fields: [segmentId], references: [id])
  source         LeadSource?          @relation(fields: [sourceId], references: [id])
  lostReason     LeadLostReason?      @relation(fields: [lostReasonId], references: [id])
  buyingPowerTier LeadBuyingPowerTier? @relation(fields: [buyingPowerTierId], references: [id])

  segmentHistory     LeadSegmentHistory[]
  temperatureHistory LeadTemperatureHistory[]
  assignments        LeadAssignment[]
  conversations      Conversation[]
  activities         LeadActivity[]
  followUps          LeadFollowUp[]
  aiAnalyses         LeadAiAnalysis[]
  aiSuggestions      LeadAiSuggestion[]
  prioritySnapshots  LeadPrioritySnapshot[]

  @@index([whatsappNumber])
  @@index([segmentId])
  @@index([sourceId])
  @@index([buyingPowerTierId])
  @@index([temperature])
  @@index([outcome])
  @@index([priorityScore])
  @@index([lastInteractionAt])
  @@index([lastChatAt])
  @@index([createdAt])
  @@index([lostReasonId])
  // Scan cron alert "lead belum direspon" (outcome OPEN + belum di-alert + pesan customer lama).
  @@index([outcome, waGroupAlertedAt, lastCustomerMessageAt])
  @@map("leads")
  @@schema("simple_system")
}

model LeadSegmentHistory {
  id              String   @id @default(uuid())
  leadId          String   @map("lead_id")
  fromSegmentId   String?  @map("from_segment_id")
  toSegmentId     String   @map("to_segment_id")
  source          String // "MANUAL" | "AI" | "RULE"
  confidence      Float?
  reason          String?
  changedByUserId String?  @map("changed_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromSegment   Segment? @relation("SegmentHistoryFrom", fields: [fromSegmentId], references: [id])
  toSegment     Segment  @relation("SegmentHistoryTo", fields: [toSegmentId], references: [id])
  changedByUser User?    @relation(fields: [changedByUserId], references: [id])

  @@index([leadId])
  @@index([fromSegmentId])
  @@index([toSegmentId])
  @@index([changedByUserId])
  @@map("lead_segment_history")
  @@schema("simple_system")
}

model LeadTemperatureHistory {
  id              String   @id @default(uuid())
  leadId          String   @map("lead_id")
  fromTemperature String?  @map("from_temperature")
  toTemperature   String   @map("to_temperature")
  source          String // "MANUAL" | "AI" | "RULE"
  scoreSnapshot   Float?   @map("score_snapshot")
  confidence      Float?
  reason          String?
  changedByUserId String?  @map("changed_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  lead          Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id])

  @@index([leadId])
  @@index([changedByUserId])
  @@map("lead_temperature_history")
  @@schema("simple_system")
}

/// "Satu active PRIMARY per lead" (docs/04-database.md §11) tidak di-enforce lewat unique
/// constraint (butuh partial index yang tidak didukung Prisma native) — divalidasi di endpoint
/// reassign/takeover lewat transaction (§28 doc yang sama): close assignment lama dulu baru
/// create yang baru, dalam satu transaction.
model LeadAssignment {
  id               String    @id @default(uuid())
  leadId           String    @map("lead_id")
  assignedUserId   String    @map("assigned_user_id")
  assignedByUserId String?   @map("assigned_by_user_id")
  assignmentType   String    @map("assignment_type") // "PRIMARY" | "TAKEOVER"
  reason           String?
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")

  lead           Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User  @relation("LeadAssignmentAssignee", fields: [assignedUserId], references: [id])
  assignedByUser User? @relation("LeadAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([leadId, isActive])
  @@index([assignedUserId, isActive])
  @@index([assignedByUserId])
  @@map("lead_assignments")
  @@schema("simple_system")
}

/// Session WAHUB per Sales — MENYIMPANG dari baseline "satu identitas bisnis" di
/// docs/01-project-overview.md §10.1 asli: project ini pakai 1 nomor WA per Sales (scan QR
/// sendiri-sendiri di app lewat WAHUB multi-session), bukan 1 nomor bisnis bersama. Alasan &
/// detail flow onboarding ada di §10.3 doc yang sama.
///
/// PENTING: WAHUB TIDAK butuh client/API key terpisah per Sales — 1 client key (punya
/// simple-system, `WAHUB_API_KEY` yang sudah ada) bisa punya banyak session sekaligus, dibedakan
/// dari `sessionId` di body request (auto-prefix `{clientId}-{sessionId}` oleh WAHUB, lihat
/// ensureSessionOwnership di source WAHUB). Tiap session punya `webhookUrl` SENDIRI-SENDIRI
/// (disimpan per-sessionId di WAHUB, bukan global) — jadi aman dijalankan berdampingan dengan
/// session "default" milik Director Assistant tanpa saling menimpa webhook. `wahubSessionId` di
/// sini = bagian LOKAL sebelum prefix (mis. `sales-{userId}`), bukan sessionId penuh.
///
/// QR code sendiri sengaja TIDAK disimpan di sini (transient, ambil live dari WAHUB
/// `GET /api/sessions/qr/{sessionId}` selama status QR_READY).
model WhatsappConnection {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id") // 1 Sales = 1 koneksi WA (MVP)
  wahubSessionId      String    @unique @map("wahub_session_id") // bagian lokal, mis. "sales-{userId}"
  phoneNumber         String?   @map("phone_number")
  status              String    @default("STARTING") @map("status") // "STARTING" | "QR_READY" | "READY" | "FAILED" | "DISCONNECTED"
  webhookRegisteredAt DateTime? @map("webhook_registered_at")
  lastConnectedAt     DateTime? @map("last_connected_at")
  lastStatusCheckAt   DateTime? @map("last_status_check_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([status])
  @@map("whatsapp_connections")
  @@schema("simple_system")
}

/// Satu lead bisa punya lebih dari satu conversation/channel di masa depan (baseline cuma
/// WhatsApp). `unreadCustomerCount` dihitung ulang tiap pesan masuk/dibaca, bukan derived saat
/// query (biar list inbox tetap cepat). `whatsappConnectionId` = koneksi WA Sales pemilik
/// percakapan ini — PIC lead (LeadAssignment PRIMARY) dibuat otomatis dari pemilik koneksi ini
/// saat conversation/lead baru pertama kali dibuat dari webhook (lihat komentar WhatsappConnection).
model Conversation {
  id                     String    @id @default(uuid())
  leadId                 String    @map("lead_id")
  whatsappConnectionId   String?   @map("whatsapp_connection_id")
  provider               String
  providerConversationId String?   @map("provider_conversation_id")
  // JID "LID" (privacy alias WhatsApp, "xxxx@lid") untuk chat ini — direkam saat pertama kali
  // terlihat barengan nomor asli. Dipakai sebagai jalur cocok cadangan kalau payload WAHUB suatu
  // saat cuma kirim @lid tanpa senderNumber/from nomor asli.
  lidJid                 String?   @map("lid_jid")
  channel                String    @default("WHATSAPP")
  status                 String    @default("OPEN") // "OPEN" | "ARCHIVED"
  lastMessageAt          DateTime? @map("last_message_at")
  unreadCustomerCount    Int       @default(0) @map("unread_customer_count")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsappConnection WhatsappConnection? @relation(fields: [whatsappConnectionId], references: [id])
  messages           Message[]
  aiSuggestions      LeadAiSuggestion[]

  @@unique([provider, providerConversationId])
  @@index([leadId])
  @@index([whatsappConnectionId])
  @@index([lidJid])
  @@map("conversations")
  @@schema("simple_system")
}

/// `senderUserId` null = pesan dari customer (inbound) ATAU sistem; wajib terisi utk outbound
/// yang dikirim staf — validasi di service layer. `providerMessageId` unique = kunci idempotency
/// webhook (retry provider tidak boleh dobel insert).
model Message {
  id                 String    @id @default(uuid())
  conversationId     String    @map("conversation_id")
  providerMessageId  String?   @unique @map("provider_message_id")
  direction          String // "INBOUND" | "OUTBOUND"
  messageType        String    @map("message_type") // "TEXT" | "IMAGE" | "DOCUMENT" | "AUDIO" | "OTHER"
  body               String?
  mediaUrl           String?   @map("media_url")
  senderUserId       String?   @map("sender_user_id")
  senderExternalId   String?   @map("sender_external_id")
  aiSuggestionId     String?   @map("ai_suggestion_id")
  sentAt             DateTime  @map("sent_at")
  receivedAt         DateTime? @map("received_at")
  deliveryStatus     String    @default("QUEUED") @map("delivery_status") // "QUEUED" | "SENT" | "DELIVERED" | "READ" | "FAILED"
  rawProviderPayload Json?     @map("raw_provider_payload")
  createdAt          DateTime  @default(now()) @map("created_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?            @relation(fields: [senderUserId], references: [id])
  aiSuggestion LeadAiSuggestion? @relation(fields: [aiSuggestionId], references: [id])

  @@index([conversationId, sentAt])
  @@index([senderUserId])
  @@index([aiSuggestionId])
  @@map("messages")
  @@schema("simple_system")
}

/// Baseline rank 1-4: DISCUSSION, ZOOM_DEMO, PROPOSAL, NEGOTIATION (lihat docs/06-business-rule.md).
model LeadActivityType {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  stageRank Int     @map("stage_rank")
  score     Int
  isActive  Boolean @default(true) @map("is_active")

  activities LeadActivity[]

  @@map("lead_activity_types")
  @@schema("simple_system")
}

model LeadActivity {
  id             String   @id @default(uuid())
  leadId         String   @map("lead_id")
  activityTypeId String   @map("activity_type_id")
  actorUserId    String   @map("actor_user_id")
  occurredAt     DateTime @map("occurred_at")
  result         String?
  note           String?
  attachmentUrl  String?  @map("attachment_url")
  source         String   @default("MANUAL") // "MANUAL" | "SYSTEM" | "AI"
  isVoid         Boolean  @default(false) @map("is_void")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  activityType LeadActivityType @relation(fields: [activityTypeId], references: [id])
  actorUser    User             @relation(fields: [actorUserId], references: [id])

  @@index([leadId, occurredAt])
  @@index([actorUserId])
  @@index([activityTypeId])
  @@map("lead_activities")
  @@schema("simple_system")
}

/// Baseline effect (bisa di-config lewat LeadSystemSetting): REQUEST_PROPOSAL +20,
/// REQUEST_DEMO +18, INTERESTED +15, CALL_LATER +8, INTERNAL_DISCUSSION +5, NO_RESPONSE -5,
/// NOT_INTERESTED -25 (lihat docs/04-database.md §16).
model LeadFollowUpResultType {
  id                     String   @id @default(uuid())
  code                   String   @unique
  name                   String
  priorityScoreEffect    Int      @map("priority_score_effect")
  temperatureSignalScore Int      @map("temperature_signal_score")
  // Skor 0-100 komponen "Hasil Follow Up" di Priority Engine (docs/06 §8). Bisa diubah di config.
  normalizedScore        Int      @default(50) @map("normalized_score")
  isPositive             Boolean? @map("is_positive")
  isActive               Boolean  @default(true) @map("is_active")

  followUps LeadFollowUp[]

  @@map("lead_follow_up_result_types")
  @@schema("simple_system")
}

/// `isOverdue` SENGAJA tidak disimpan sebagai kolom (derived: status=OPEN && now >
/// scheduledAt + grace, lihat docs/04-database.md §27) — hitung di query/service layer supaya
/// tidak perlu cron buat sinkronisasi status. `nextFollowUpId` unique = self relation 1:1
/// (follow-up hasil tindak-lanjut dari follow-up ini).
model LeadFollowUp {
  id              String    @id @default(uuid())
  leadId          String    @map("lead_id")
  assignedUserId  String    @map("assigned_user_id")
  createdByUserId String    @map("created_by_user_id")
  scheduledAt     DateTime  @map("scheduled_at")
  purpose         String
  note            String?
  status          String    @default("OPEN") // "OPEN" | "COMPLETED" | "CANCELLED"
  source          String    @default("MANUAL") // "MANUAL" | "AUTO" (dijadwalkan sistem)
  resultTypeId    String?   @map("result_type_id")
  resultNote      String?   @map("result_note")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  isOnTime        Boolean?  @map("is_on_time")
  nextFollowUpId  String?   @unique @map("next_follow_up_id")
  reminderSentAt  DateTime? @map("reminder_sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lead             Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser     User                    @relation("LeadFollowUpAssignee", fields: [assignedUserId], references: [id])
  createdByUser    User                    @relation("LeadFollowUpCreator", fields: [createdByUserId], references: [id])
  resultType       LeadFollowUpResultType? @relation(fields: [resultTypeId], references: [id])
  nextFollowUp     LeadFollowUp?           @relation("FollowUpChain", fields: [nextFollowUpId], references: [id])
  previousFollowUp LeadFollowUp?           @relation("FollowUpChain")

  @@index([assignedUserId, scheduledAt])
  @@index([leadId, scheduledAt])
  @@index([status])
  @@index([resultTypeId])
  @@index([createdByUserId])
  @@map("lead_follow_ups")
  @@schema("simple_system")
}

/// Versioned AI output — jangan pernah overwrite baris lama, selalu insert baru dengan
/// `version` naik supaya histori keputusan AI bisa diaudit (docs/04-database.md §18).
model LeadAiAnalysis {
  id                  String   @id @default(uuid())
  leadId              String   @map("lead_id")
  analysisType        String   @map("analysis_type") // "SEGMENTATION" | "PROFILING" | "SUMMARY" | "NEXT_BEST_ACTION" | "BUYING_SIGNAL" | "TEMPERATURE_RECOMMENDATION" | "BUYING_POWER_RECOMMENDATION"
  version             Int
  modelName           String   @map("model_name")
  promptVersion       String   @map("prompt_version")
  inputUntilMessageId String?  @map("input_until_message_id")
  inputContextHash    String?  @map("input_context_hash")
  outputJson          Json     @map("output_json")
  confidence          Float?
  status              String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  errorCode           String?  @map("error_code")
  createdAt           DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, analysisType])
  @@map("lead_ai_analyses")
  @@schema("simple_system")
}

/// AI tidak boleh auto-send pada baseline MVP (docs/01-project-overview.md §9.4) — `usedAt`/
/// `usedByUserId` baru terisi kalau sales benar-benar menekan "Gunakan" lalu kirim.
model LeadAiSuggestion {
  id             String    @id @default(uuid())
  leadId         String    @map("lead_id")
  conversationId String    @map("conversation_id")
  style          String // "PROFESSIONAL" | "CASUAL" | "CLOSING"
  text           String
  modelName      String    @map("model_name")
  promptVersion  String    @map("prompt_version")
  generatedAt    DateTime  @default(now()) @map("generated_at")
  usedAt         DateTime? @map("used_at")
  usedByUserId   String?   @map("used_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  usedByUser   User?        @relation(fields: [usedByUserId], references: [id])
  messages     Message[]

  @@index([leadId])
  @@index([conversationId])
  @@index([usedByUserId])
  @@map("lead_ai_suggestions")
  @@schema("simple_system")
}

/// Snapshot tiap kali Priority Engine menghitung ulang skor 1 lead — `leads.priorityScore`
/// menyimpan nilai terbaru buat query cepat (list/sort), tabel ini buat audit/analytics
/// breakdown per komponen (docs/04-database.md §20 & §8).
model LeadPrioritySnapshot {
  id                   String   @id @default(uuid())
  leadId               String   @map("lead_id")
  score                Float
  level                String // "LOW" | "MONITOR" | "HIGH" | "TOP"
  componentTemperature Float    @map("component_temperature")
  componentActivity    Float    @map("component_activity")
  componentFollowUp    Float    @map("component_follow_up")
  componentRecency     Float    @map("component_recency")
  componentAi          Float    @map("component_ai")
  reasonJson           Json     @map("reason_json")
  ruleVersion          String   @map("rule_version")
  calculatedAt         DateTime @default(now()) @map("calculated_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, calculatedAt])
  @@map("lead_priority_snapshots")
  @@schema("simple_system")
}

/// Role-aware & scope-aware notification (lead di-assign, follow up jatuh tempo, dst) — beda
/// dari LeadFollowUp.reminderSentAt yang cuma flag internal, ini yang benar-benar tampil/di-push
/// ke user. `dedupeKey` unique (nullable-safe di Postgres) buat tipe yang butuh dedupe.
model LeadNotification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  title       String
  body        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  deepLink    String?   @map("deep_link")
  dedupeKey   String?   @unique @map("dedupe_key")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  readAt      DateTime? @map("read_at")
  status      String    @default("PENDING") // "PENDING" | "SENT" | "FAILED" | "READ"
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("lead_notifications")
  @@schema("simple_system")
}

/// Web Push subscription per device — generic (bukan spesifik Marketing), taruh di sini dulu
/// karena modul Marketing yang pertama butuh PWA push; modul lain boleh reuse tabel yang sama.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  endpoint   String    @unique
  p256dh     String?
  auth       String?
  userAgent  String?   @map("user_agent")
  deviceName String?   @map("device_name")
  isActive   Boolean   @default(true) @map("is_active")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
  @@schema("simple_system")
}

/// Append-only — jangan pernah sediakan endpoint edit/delete baris di sini (docs/04-database.md
/// §24). Generic (bukan spesifik Marketing), tapi baris pertama yang mengisinya kemungkinan
/// besar dari modul ini (reassign/takeover/won/lost lead).
model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  beforeJson   Json?    @map("before_json")
  afterJson    Json?    @map("after_json")
  metadataJson Json?    @map("metadata_json")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  actorUser User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
  @@schema("simple_system")
}

/// Key-value tunable khusus Priority Engine/Follow Up/AI Marketing (priority.weights,
/// follow_up.grace_minutes, temperature.automation_mode, dst — lihat docs/04-database.md §25).
/// TERPISAH dari model `Settings` yang sudah ada (itu singleton split kas operasional/direksi/
/// bonus buat modul Internal, beda domain sama sekali).
model LeadSystemSetting {
  key             String   @id
  valueJson       Json     @map("value_json")
  description     String?
  updatedByUserId String   @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  updatedByUser User @relation(fields: [updatedByUserId], references: [id])

  @@map("lead_system_settings")
  @@schema("simple_system")
}

/// Optional (docs/04-database.md §26) — log mentah tiap webhook WhatsApp masuk buat
/// idempotency/debug, terpisah dari Message.providerMessageId yang cuma dedupe di level pesan.
model LeadWebhookEvent {
  id               String    @id @default(uuid())
  provider         String
  providerEventId  String    @map("provider_event_id")
  eventType        String    @map("event_type")
  payload          Json
  receivedAt       DateTime  @default(now()) @map("received_at")
  processedAt      DateTime? @map("processed_at")
  processingStatus String    @default("PENDING") @map("processing_status") // "PENDING" | "PROCESSED" | "FAILED"
  error            String?

  @@unique([provider, providerEventId])
  @@map("lead_webhook_events")
  @@schema("simple_system")
}
