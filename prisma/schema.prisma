generator client {
  provider = "prisma-client-js"
}

// Sengaja pakai Postgres schema terpisah ("simple_system") di project Supabase yang sama
// dengan Director Assistant, supaya nama tabel (users, sessions, transactions, dst) tidak
// bentrok dengan schema "public" milik Director Assistant yang sudah jalan duluan.
datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["simple_system"]
}

// ---------------------------------------------------------------------------
// Auth & Role
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phoneNumber  String?   @map("phone_number")
  role         String    @default("admin") // "owner" | "direktur" | "admin"
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("users")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Pengembangan Sistem — daftar fitur/perbaikan yang akan/sedang dikerjakan di
// aplikasi ini sendiri (bukan data operasional client). Semua role bisa lihat &
// tambah usulan; status cuma "belum"/"proses"/"selesai" (bukan Prisma enum,
// sama pola dengan Transaction.postStatus dkk).
// ---------------------------------------------------------------------------
model SystemDevelopmentItem {
  id            String   @id @default(uuid())
  title         String
  description   String?
  status        String   @default("belum") // "belum" | "proses" | "selesai"
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("system_development_items")
  @@schema("simple_system")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Master data hasil migrasi dari aplikasi lama (lihat scripts/migrate-legacy.ts)
// ---------------------------------------------------------------------------

model Client {
  id                   String   @id @default(uuid())
  legacyId             Int?     @unique @map("legacy_id")
  legacySalesClientId  String?  @unique @map("legacy_sales_client_id") // link manual ke LegacySalesClient (dicocokkan belakangan)
  name        String
  email       String?
  phoneNumber String?  @map("phone_number")
  picName     String?  @map("pic_name")
  picPhone    String?  @map("pic_phone")
  city        String?
  address     String?
  notes       String?
  // Instansi pemerintah/badan yang berstatus Pemungut PPN — PPN atas invoice ke client ini
  // disetor LANGSUNG oleh client ke kas negara (bukti pungut), TIDAK ditransfer ke kita.
  // Efeknya: sisa tagih/lunas invoice dihitung dari DPP saja (totalAmount - ppnAmount), lihat
  // `invoiceCashDue` di lib/invoice-due.ts — jangan hitung ulang manual di tempat lain.
  isPemungutPpn Boolean @default(false) @map("is_pemungut_ppn")
  createdAt   DateTime @default(now()) @map("created_at")

  domains            Domain[]
  subdomains         Subdomain[]
  invoices           Invoice[]
  payments           Payment[]
  servers            Server[]
  maintenances       Maintenance[]
  projects           Project[]
  legacySalesClient  LegacySalesClient? @relation(fields: [legacySalesClientId], references: [id])

  @@map("clients")
  @@schema("simple_system")
}

/// Staging: 326 pelanggan mentah dari aplikasi penjualan lama (m_pelanggan, server .86) —
/// SENGAJA belum otomatis digabung ke tabel Client utama supaya bisa dicocokkan manual dulu
/// (banyak kemungkinan duplikat dengan 125 client hasil migrasi pertama). Client baru yang
/// dibuat otomatis saat migrasi piutang (karena Invoice butuh Client asli) tetap ditandai lewat
/// relasi legacySalesClientId di atas.
model LegacySalesClient {
  id           String   @id @default(uuid())
  legacyId     Int      @unique @map("legacy_id") // m_pelanggan.id
  kode         String?
  name         String   @map("namalengkap")
  phoneNumber  String?  @map("phone_number")
  address      String?
  bankName     String?  @map("bank_name")
  bankAccount  String?  @map("bank_account")
  paymentTermDays Int?  @map("payment_term_days")
  creditLimit  Float?   @map("credit_limit")
  createdAt    DateTime @default(now()) @map("created_at")

  client Client?

  @@map("legacy_sales_clients")
  @@schema("simple_system")
}

model Vendor {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String
  website  String?

  servers        Server[]
  recurringBills RecurringBill[]

  @@map("vendors")
  @@schema("simple_system")
}

model BillingPeriod {
  id                 String @id @default(uuid())
  legacyId           Int?   @unique @map("legacy_id")
  name               String // "Bulanan", "Tahunan", "2 Tahunan", "3 Bulanan", "6 Bulanan"
  reminderDaysBefore Int    @map("reminder_days_before")

  servers        Server[]
  recurringBills RecurringBill[]
  maintenances   Maintenance[]

  @@map("billing_periods")
  @@schema("simple_system")
}

model CloudType {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String

  servers        Server[]
  cpanelAccounts CpanelAccount[]

  @@map("cloud_types")
  @@schema("simple_system")
}

model HostingPackage {
  id       String @id @default(uuid())
  legacyId Int?   @unique @map("legacy_id")
  name     String

  cpanelAccounts CpanelAccount[]

  @@map("hosting_packages")
  @@schema("simple_system")
}

model Server {
  id                String    @id @default(uuid())
  legacyId          Int?      @unique @map("legacy_id")
  name              String
  ipAddress         String?   @map("ip_address")
  vendorId          String?   @map("vendor_id")
  cloudTypeId       String?   @map("cloud_type_id")
  clientId          String?   @map("client_id") // kosong = infra internal 7Smarts, terisi = disewakan ke client ini
  core              String?
  ram               String?
  storage           String?
  dnsServer1        String?   @map("dns_server_1")
  dnsServer2        String?   @map("dns_server_2")
  subscriptionStart DateTime? @map("subscription_start")
  billingDayOfMonth Int?      @map("billing_day_of_month")
  periodId          String?   @map("period_id")
  periodCount       Int?      @map("period_count")
  price             Float?
  lastPaidAt        DateTime? @map("last_paid_at")
  // "Tgl Berakhir" — acuan renewal resmi, sama peran dengan Domain.expiryDate: begitu dibayar,
  // INI yang dimajukan sesuai siklus periode (bukan lastPaidAt/tanggal bayar), supaya telat
  // bayar tidak menggeser siklus jatuh tempo berikutnya. Nullable — fallback ke
  // lastPaidAt+periode buat baris yang belum pernah kesetel (lihat resolveServerExpiry).
  expiryDate        DateTime? @map("expiry_date")
  lastCheckinAt     DateTime? @map("last_checkin_at")
  active            Boolean   @default(true)
  legacyActiveFlag  String?   @map("legacy_active_flag")

  vendor    Vendor?        @relation(fields: [vendorId], references: [id])
  cloudType CloudType?     @relation(fields: [cloudTypeId], references: [id])
  period    BillingPeriod? @relation(fields: [periodId], references: [id])
  client    Client?        @relation(fields: [clientId], references: [id])

  @@map("servers")
  @@schema("simple_system")
}

/// Jasa maintenance berkala ke client (mis. maintenance website bulanan) — sisi pendapatan
/// (price, ditagihkan ke client) sama seperti Domain/Server, punya biaya modal (HPP) sendiri
/// yang ditandai lunas terpisah lewat "Bayar Maintenance" (lihat markMaintenancePaid).
model Maintenance {
  id          String    @id @default(uuid())
  name        String
  clientId    String    @map("client_id") // wajib — beda dari Domain/Server, maintenance selalu untuk client tertentu
  periodId    String?   @map("period_id")
  periodCount Int?      @map("period_count")
  price       Float?
  lastPaidAt  DateTime? @map("last_paid_at")
  // Bulan mulai kontrak maintenance ini — cuma bulan+tahun yang berarti (disimpan sebagai
  // tanggal 1 di bulan itu), murni informasi, TIDAK dipakai buat hitung jatuh tempo
  // (itu tetap dari lastPaidAt + periode, lihat computeNextDueDate).
  subscriptionStart DateTime? @map("subscription_start")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  client Client         @relation(fields: [clientId], references: [id])
  period BillingPeriod? @relation(fields: [periodId], references: [id])

  @@map("maintenances")
  @@schema("simple_system")
}

/// SLA tindak-lanjut tagihan (lihat sop.txt) — satu record = satu siklus tagihan buat Domain/
/// Server/Maintenance yang punya Client. refType/refId ikut pola polymorphic yang sama dengan
/// Transaction.refType/refId. Begitu paidRecordedAt terisi, siklus itu selesai; jatuh tempo
/// berikutnya bikin record baru (bukan reuse) — "record aktif" per (refType,refId) = yang
/// paidRecordedAt-nya masih null.
model BillingFollowUp {
  id        String  @id @default(uuid())
  refType   String  @map("ref_type") // "domain" | "server" | "maintenance" | "project_termin" | "invoice"
  refId     String  @map("ref_id")
  // Nullable — invoice manual & Project termin tidak lewat tahap "reminder muncul di Dashboard"
  // (langsung dibuat), siklusnya mulai langsung dari invoicedAt buat 2 jenis itu.
  dueAppearedAt DateTime? @map("due_appeared_at")
  invoicedAt    DateTime? @map("invoiced_at")
  invoicedById  String?   @map("invoiced_by_id") // null = auto-generate sistem (mis. cron Project termin)
  invoiceId     String?   @map("invoice_id")
  // Salinan "respon terakhir" (denormalized dari BillingFollowUpResponse terbaru) — dipakai
  // computeSlaStatus buat hitung tahap/deadline tanpa query tabel log tiap kali. Histori
  // lengkapnya ada di BillingFollowUpResponse (relasi responses di bawah).
  clientRespondedAt DateTime? @map("client_responded_at")
  promisedPayAt     DateTime? @map("promised_pay_at")
  paidRecordedAt    DateTime? @map("paid_recorded_at")
  paidRecordedById  String?   @map("paid_recorded_by_id")
  // Terisi kalau invoice yang nempel di siklus ini dibatalkan (Void) — invoicedAt/invoiceId
  // ikut direset ke null bareng ini (lihat POST /api/invoices/[id]/void) supaya siklusnya balik
  // ke tahap "perlu ditagih ulang" (bedain dari belum_ditagih yang benar-benar belum pernah
  // ditagih sama sekali — lihat computeSlaStatus di billing-follow-up.ts).
  voidedAt          DateTime? @map("voided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  responses BillingFollowUpResponse[]

  @@index([refType, refId])
  @@map("billing_follow_ups")
  @@schema("simple_system")
}

/// Log respon Client — 1 baris per kali staf input respon (bukan ditimpa), supaya histori
/// follow-up 1 piutang kelihatan lengkap (lihat Dashboard > Piutang). BillingFollowUp.
/// clientRespondedAt/promisedPayAt tetap disalin dari baris TERBARU di sini setiap kali ada
/// respon baru masuk, biar computeSlaStatus tidak perlu diubah.
model BillingFollowUpResponse {
  id                String   @id @default(uuid())
  billingFollowUpId String   @map("billing_follow_up_id")
  responseType      String   @map("response_type") // "sudah_bayar" | "janji_bayar" | "nego" | "tidak_respon" | "lainnya"
  note              String?
  promisedPayAt     DateTime? @map("promised_pay_at")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  billingFollowUp BillingFollowUp @relation(fields: [billingFollowUpId], references: [id], onDelete: Cascade)

  @@index([billingFollowUpId])
  @@map("billing_follow_up_responses")
  @@schema("simple_system")
}

model CpanelAccount {
  id          String  @id @default(uuid())
  legacyId    Int?    @unique @map("legacy_id")
  name        String
  username    String?
  password    String? // dimigrasi apa adanya (plaintext di sumber) — lihat catatan keamanan di plan
  cloudTypeId String? @map("cloud_type_id")
  packageId   String? @map("package_id")
  active      Boolean @default(true)

  cloudType CloudType?      @relation(fields: [cloudTypeId], references: [id])
  package   HostingPackage? @relation(fields: [packageId], references: [id])
  domains   Domain[]

  @@map("cpanel_accounts")
  @@schema("simple_system")
}

model Domain {
  id               String    @id @default(uuid())
  legacyId         Int?      @unique @map("legacy_id")
  name             String
  clientId         String?   @map("client_id")
  cpanelAccountId  String?   @map("cpanel_account_id")
  sellPrice        Float?    @map("sell_price")
  activatedAt      DateTime? @map("activated_at")
  lastPaidAt       DateTime? @map("last_paid_at")
  // Tanggal acuan renewal — kalau dibayar, INI yang ditambah 1 tahun (bukan lastPaidAt),
  // supaya telat bayar tidak menggeser siklus jatuh tempo tahun depan (lihat
  // finalizeTransactionPosting di mark-paid.ts). lastPaidAt murni catatan "kapan terakhir
  // dibayar"; expiryDate murni "kapan servicenya berakhir" — dua hal beda yang dulu digabung.
  expiryDate       DateTime? @map("expiry_date")
  active           Boolean   @default(true)
  legacyActiveFlag String?   @map("legacy_active_flag")
  createdAt        DateTime  @default(now()) @map("created_at")

  client        Client?        @relation(fields: [clientId], references: [id])
  cpanelAccount CpanelAccount? @relation(fields: [cpanelAccountId], references: [id])
  subdomains    Subdomain[]

  @@map("domains")
  @@schema("simple_system")
}

model Subdomain {
  id               String    @id @default(uuid())
  legacyId         Int?      @unique @map("legacy_id")
  domainId         String?   @map("domain_id")
  name             String
  clientId         String?   @map("client_id")
  sellPrice        Float?    @map("sell_price")
  activatedAt      DateTime? @map("activated_at")
  lastPaidAt       DateTime? @map("last_paid_at")
  legacyActiveFlag String?   @map("legacy_active_flag")

  domain Domain? @relation(fields: [domainId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@map("subdomains")
  @@schema("simple_system")
}

model RecurringBill {
  id                String    @id @default(uuid())
  legacyId          Int?      @unique @map("legacy_id")
  name              String
  identifier        String?   @map("identifier") // Nomor ID / Keterangan (mis. nomor pelanggan PLN, ID akun, dsb)
  vendorId          String?   @map("vendor_id")
  category          String    @default("kantor") // "kantor" | "pribadi" | "lainnya"
  subscriptionStart DateTime? @map("subscription_start")
  billingDayOfMonth Int?      @map("billing_day_of_month")
  periodId          String?   @map("period_id")
  periodCount       Int?      @map("period_count")
  // Cuma relevan kalau period-nya "Mingguan" — hari dalam seminggu biaya ini biasa dibayar
  // (1=Senin .. 7=Minggu, sama konvensi dengan jakartaIsoWeekday di lib/datetime.ts). Murni info
  // buat staf, tidak dipakai hitung jatuh tempo (itu tetap dari lastPaidAt + periode).
  payDayOfWeek      Int?      @map("pay_day_of_week")
  price             Float?
  lastPaidAt        DateTime? @map("last_paid_at")
  lastCheckinAt     DateTime? @map("last_checkin_at") // kapan terakhir ditanya "sudah dibayar?" via WA
  active            Boolean   @default(true)

  vendor Vendor?        @relation(fields: [vendorId], references: [id])
  period BillingPeriod? @relation(fields: [periodId], references: [id])

  @@map("recurring_bills")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Penjualan / Invoicing — mekanisme Piutang
// ---------------------------------------------------------------------------

model Item {
  id           String  @id @default(uuid())
  legacyId     Int?    @unique @map("legacy_id") // dari m_jasa aplikasi penjualan lama (server .86)
  name         String
  type         String  @default("jasa") // "jasa" | "barang"
  defaultPrice Float   @default(0) @map("default_price")
  defaultCost  Float   @default(0) @map("default_cost")
  unit         String?
  active       Boolean @default(true)

  invoiceLines InvoiceLine[]

  @@map("items")
  @@schema("simple_system")
}

model Invoice {
  id            String   @id @default(uuid())
  legacyId      String?  @unique @map("legacy_id") // id (UUID) t_penjualan aplikasi penjualan lama, buat piutang migrasi
  invoiceNumber String   @unique @map("invoice_number")
  clientId      String   @map("client_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  dueDate       DateTime? @map("due_date")
  subtotal      Float    @default(0)
  discountAmount Float   @default(0) @map("discount_amount")
  ppnEnabled    Boolean  @default(false) @map("ppn_enabled")
  ppnRate       Float    @default(11) @map("ppn_rate")
  ppnAmount     Float    @default(0) @map("ppn_amount")
  totalAmount   Float    @default(0) @map("total_amount")
  totalCost     Float    @default(0) @map("total_cost")
  status        String   @default("unpaid") // "unpaid" | "partial" | "paid" | "claimed_paid"
  notes         String?

  // Arsip bukti setor PPN oleh client Pemungut PPN (mis. instansi pemerintah) — CATATAN saja,
  // tidak ada efek jurnal (PPN-nya memang tidak pernah masuk kas kita, lihat Client.isPemungutPpn
  // dan invoiceCashDue di lib/invoice-due.ts). Diisi manual, boleh kosong walau client-nya
  // pemungut (bukti belum diterima) — tidak menghalangi invoice ditandai lunas di DPP.
  noBuktiPungutPpn  String?   @map("no_bukti_pungut_ppn")
  tglBuktiPungutPpn DateTime? @map("tgl_bukti_pungut_ppn")

  // DP yang DISEPAKATI/direncanakan (mis. dinas janji bayar DP dulu) — CATATAN saja, sama pola
  // dengan noBuktiPungutPpn/Piutang Termin Project: TIDAK ADA efek kas/jurnal, karena uangnya
  // belum benar-benar masuk. Beda dari pelunasan asli (InvoicePayment, lewat menu Pembayaran)
  // yang baru itu jurnal Kas/Bank + Pendapatan. Dipakai buat tampilkan estimasi "Sisa Setelah DP"
  // di invoice cetak SEBELUM ada uang masuk sama sekali — begitu ada InvoicePayment asli, nota
  // beralih pakai angka pelunasan asli (lihat NotaPrintable), bukan dpAmount ini lagi.
  dpAmount Float @default(0) @map("dp_amount")
  lastFollowUpAt DateTime? @map("last_follow_up_at") // kapan terakhir AI Agent follow-up ke Client
  createdAt     DateTime @default(now()) @map("created_at")

  // Null = perilaku default (posting ke COA_CODE.pendapatanJasa saat dibayar, lihat
  // invoicePaymentLines). Diisi eksplisit oleh sumber invoice tertentu (mis. auto-generate
  // termin Project) yang pendapatannya harus masuk ke akun revenue lain dari Pendapatan Jasa.
  revenueCoaCode String? @map("revenue_coa_code")

  // Kalau invoice ini dibuat dari tombol "Tagih Sekarang" di Dashboard (Domain/Server), simpan
  // domain/server yang dimaksud di sini — dipakai form Pembayaran buat otomatis pilih "Bayar
  // Domain/Server" + itemnya begitu invoice ini dilunasi, staf tidak perlu pilih manual lagi.
  costLinkType String? @map("cost_link_type") // "domain" | "server"
  costLinkId   String? @map("cost_link_id")

  // Draft -> Posted -> (Voided): efek invoice (masuk Piutang, jurnal HPP kalau ada) baru
  // berlaku setelah posted. Terpisah dari `status` di atas (itu status pelunasan, bukan ini).
  // Voided = salah input setelah posting — dibatalkan (bukan dihapus), efeknya hilang dari
  // Piutang/laporan tapi tetap kelihatan di riwayat dengan badge "Dibatalkan".
  postStatus  String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt    DateTime? @map("posted_at")
  postedById  String?   @map("posted_by_id")
  voidedAt    DateTime? @map("voided_at")
  voidedById  String?   @map("voided_by_id")
  voidReason  String?   @map("void_reason")

  client   Client           @relation(fields: [clientId], references: [id])
  lines    InvoiceLine[]
  payments InvoicePayment[]
  projectPaymentSchedule ProjectPaymentSchedule?

  @@map("invoices")
  @@schema("simple_system")
}

model InvoiceLine {
  id             String @id @default(uuid())
  invoiceId      String @map("invoice_id")
  itemId         String? @map("item_id")
  description    String
  qty            Float  @default(1)
  unitPrice      Float  @map("unit_price")
  unitCost       Float  @default(0) @map("unit_cost")
  discountAmount Float  @default(0) @map("discount_amount")
  lineTotal      Float  @map("line_total")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@map("invoice_lines")
  @@schema("simple_system")
}

model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  accountId     String   @map("account_id")
  paymentId     String?  @map("payment_id") // grup ke kwitansi Payment (menu Pembayaran) — null utk payment lama/migrasi
  amount        Float
  costAmount    Float    @default(0) @map("cost_amount") // HPP tambahan yang diinput manual saat transaksi ini (di luar HPP baris invoice)
  paidAt        DateTime @default(now()) @map("paid_at")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  transactionId String?  @unique @map("transaction_id")

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  account     Account      @relation(fields: [accountId], references: [id])
  payment     Payment?     @relation(fields: [paymentId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@map("invoice_payments")
  @@schema("simple_system")
}

/// Kwitansi pembayaran (menu Pembayaran) — satu Payment bisa melunasi/mencicil beberapa
/// Invoice milik 1 Client sekaligus, tiap Invoice yang dibayar tercatat sbg 1 InvoicePayment.
model Payment {
  id            String   @id @default(uuid())
  paymentNumber String   @unique @map("payment_number") // PMT/{tahun}/{5 digit berurut}
  clientId      String   @map("client_id")
  accountId     String   @map("account_id")
  totalAmount   Float    @map("total_amount")
  notes         String?
  paidAt        DateTime @default(now()) @map("paid_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Draft -> Posted -> (Voided): piutang belum berkurang & saldo kas belum bergerak sampai
  // posted. Voided = dibatalkan setelah posting karena salah input, lihat catatan di Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  client          Client           @relation(fields: [clientId], references: [id])
  account         Account          @relation(fields: [accountId], references: [id])
  invoicePayments InvoicePayment[]

  @@map("payments")
  @@schema("simple_system")
}

/// Project development dengan pembayaran termin (DP/Termin 1/dst) — lihat ProjectPaymentSchedule.
/// "Nilai Total" & "Sisa Tagih" sengaja tidak disimpan di sini, dihitung dari schedules/invoice
/// supaya tidak ada dua sumber kebenaran yang bisa desinkron.
model Project {
  id        String    @id @default(uuid())
  name      String
  clientId  String    @map("client_id")
  picName   String?   @map("pic_name")
  picPhone  String?   @map("pic_phone")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  status    String    @default("berjalan") // "berjalan" | "selesai" | "batal"
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")

  client    Client                   @relation(fields: [clientId], references: [id])
  schedules ProjectPaymentSchedule[]

  @@map("projects")
  @@schema("simple_system")
}

/// 1 baris = 1 termin pembayaran project (DP, Termin 1, dst). Invoice-nya auto-generate H-3
/// sebelum dueDate (lihat src/lib/cron/project-termin-invoicing.ts) atau manual lewat tombol
/// "Generate Invoice Sekarang" — begitu invoiceId terisi, nominal harus diubah lewat Invoice-nya
/// langsung, bukan di sini. "Nominal Dibayar"/"Sisa Tagih" dihitung dari invoice.payments, tidak
/// disimpan (piutang termin = catatan/computed saja, bukan akun GL — lihat journal-rules.ts).
model ProjectPaymentSchedule {
  id                 String    @id @default(uuid())
  projectId          String    @map("project_id")
  label              String    // "DP", "Termin 1", "Termin 2", dst — bebas diketik
  sortOrder          Int       @default(0) @map("sort_order")
  dueDate            DateTime  @map("due_date") // Tgl Penagihan
  amount             Float     @map("amount")    // Nominal Tagih
  invoiceId          String?   @unique @map("invoice_id")
  invoiceGeneratedAt DateTime? @map("invoice_generated_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("project_payment_schedules")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Keuangan
// ---------------------------------------------------------------------------

model Account {
  id             String   @id @default(uuid())
  name           String
  type           String   // "kas" | "bank"
  bankName       String?  @map("bank_name")
  accountNumber  String?  @map("account_number")
  openingBalance Float    @default(0) @map("opening_balance")
  coaAccountId   String?  @map("coa_account_id")
  createdAt      DateTime @default(now()) @map("created_at")

  transactions       Transaction[]
  invoicePayments    InvoicePayment[]
  payments           Payment[]
  coaAccount         ChartOfAccount?   @relation(fields: [coaAccountId], references: [id])
  transfersOut       AccountTransfer[] @relation("AccountTransferSource")
  transfersIn        AccountTransfer[] @relation("AccountTransferDestination")

  @@map("accounts")
  @@schema("simple_system")
}

model Category {
  id           String  @id @default(uuid())
  name         String
  kind         String  // "income" | "expense" | "hpp"
  coaAccountId String? @map("coa_account_id")

  transactions Transaction[]
  coaAccount   ChartOfAccount? @relation(fields: [coaAccountId], references: [id])

  @@map("categories")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// Akuntansi Akrual: Chart of Accounts + Jurnal Umum (double-entry)
// Berjalan berdampingan dengan pencatatan cash-basis di atas — TIDAK
// menggantikan Transaction/InvoicePayment, cuma menambah jurnal debit/kredit
// otomatis di titik yang sama. Lihat src/lib/accounting/.
// ---------------------------------------------------------------------------

model ChartOfAccount {
  id        String   @id @default(uuid())
  code      String   @unique // "1-1001", "4-1000", dst — menentukan urutan tampil
  name      String
  type      String   // "asset" | "liability" | "equity" | "revenue" | "cogs" | "expense"
  parentId  String?  @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  isParent  Boolean  @default(false) @map("is_parent") // kalau true, akun ini boleh ditambahi sub-akun (anak)
  createdAt DateTime @default(now()) @map("created_at")

  parent       ChartOfAccount?  @relation("COAHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("COAHierarchy")
  journalLines JournalLine[]
  accounts     Account[]
  categories   Category[]
  roleAccess   RoleCoaAccess[]

  @@map("chart_of_accounts")
  @@schema("simple_system")
}

/// Daftar akun COA yang boleh dilihat 1 role tertentu di Akuntansi > Buku Besar (lihat Pengaturan
/// > Akses COA per Role) — cuma dipakai buat role yang DIBATASI (role "admin"), Owner/Direktur
/// selalu bebas lihat semua akun tanpa perlu baris di tabel ini. Kalau role tidak punya baris
/// sama sekali di sini, dianggap belum di-set (bukan berarti "boleh semua" atau "tidak boleh
/// sama sekali") — lihat guard di app/akuntansi/buku-besar/page.tsx.
model RoleCoaAccess {
  id           String   @id @default(uuid())
  role         String // "admin" — role lain (owner/direktur) tidak butuh baris di sini
  coaAccountId String   @map("coa_account_id")
  createdAt    DateTime @default(now()) @map("created_at")

  coaAccount ChartOfAccount @relation(fields: [coaAccountId], references: [id], onDelete: Cascade)

  @@unique([role, coaAccountId])
  @@map("role_coa_access")
  @@schema("simple_system")
}

model JournalEntry {
  id          String   @id @default(uuid())
  entryNumber String   @unique @map("entry_number") // "JE-2026-000001"
  date        DateTime
  description String
  sourceType  String   @map("source_type") // "invoice" | "invoice_revenue" | "invoice_payment" | "transaction" | "recurring_bill" | "server" | "domain" | "manual" | "correction"
  sourceId    String?  @map("source_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  // Draft -> Posted -> (Voided): baris jurnal bisa ditinjau/diedit selama draft, tidak masuk
  // hitungan laporan/saldo/buku besar sampai posted, dan terkunci begitu posted. Voided =
  // dibatalkan setelah posting karena salah input (tetap tampil di Jurnal Umum dgn badge,
  // tapi tidak dihitung di saldo/laporan manapun) — lihat catatan di model Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  lines           JournalLine[]
  transaction     Transaction?
  accountTransfer AccountTransfer?

  @@map("journal_entries")
  @@schema("simple_system")
}

model JournalLine {
  id             String @id @default(uuid())
  journalEntryId String @map("journal_entry_id")
  accountId      String @map("account_id")
  debit          Float  @default(0)
  credit         Float  @default(0)
  memo           String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
  @@schema("simple_system")
}

model Transaction {
  id                  String   @id @default(uuid())
  // Nomor bukti kas keluar/masuk — BKK/{tahun}/{5 digit urut} (expense) atau
  // BKM/{tahun}/{5 digit urut} (income), sama pola dengan Payment.paymentNumber (PMT) &
  // Invoice.invoiceNumber (INV). Nullable karena baris lama (sebelum kolom ini ada) tidak
  // di-backfill.
  transactionNumber   String?  @unique @map("transaction_number")
  accountId           String   @map("account_id")
  type                String   // "income" | "expense"
  categoryId          String?  @map("category_id")
  grossAmount         Float    @map("gross_amount")
  cost                Float    @default(0)
  netAmount           Float    @map("net_amount")
  splitOperasionalPct Float?   @map("split_operasional_pct")
  splitDireksiPct     Float?   @map("split_direksi_pct")
  splitBonusPct       Float?   @map("split_bonus_pct")
  operasionalAmount   Float?   @map("operasional_amount")
  direksiAmount       Float?   @map("direksi_amount")
  bonusAmount         Float?   @map("bonus_amount")
  description         String?
  occurredAt          DateTime @default(now()) @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")

  // Draft -> Posted -> (Voided): saldo akun belum bergerak sampai posted (lihat
  // computeAccountBalance). Voided = dibatalkan setelah posting, lihat catatan di Invoice.
  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  // Referensi balik opsional ke Server/Domain/RecurringBill kalau Transaction ini hasil
  // "Bayar Server/Domain"/"Tandai Lunas" — dipakai endpoint posting utk tahu lastPaidAt
  // milik record mana yang perlu diupdate saat Transaction ini di-posting.
  refType String? @map("ref_type") // "server" | "domain" | "recurring_bill" | "maintenance"
  refId   String? @map("ref_id")

  // Kalau Transaction ini dibuat sebagai bagian dari 1 Payment (baris pelunasan invoice ATAU
  // costLink Bayar Domain/Server yang dikaitkan ke pembayaran itu) — dipakai
  // POST /api/payments/[id]/post utk tahu Transaction mana saja yang perlu ikut diposting.
  paymentId String? @map("payment_id")

  // Link presisi ke JournalEntry yang dibuat BARENGAN transaksi ini (bukan lookup by
  // sourceType+sourceId — itu sengaja dipakai bareng-bareng oleh SEMUA histori pembayaran
  // domain/server yang sama, jadi kalau dipakai buat "Lihat Jurnal" 1 transaksi tertentu bisa
  // kebawa jurnal punya transaksi lain/lama yang sudah dibatalkan). Nullable karena baris lama
  // (sebelum kolom ini ada) belum kesetel.
  journalEntryId String? @unique @map("journal_entry_id")

  account        Account         @relation(fields: [accountId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  invoicePayment InvoicePayment?
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@map("transactions")
  @@schema("simple_system")
}

// Pindah Buku — pemindahan saldo antar akun kas/bank sendiri (bukan pendapatan/beban), mis.
// tarik tunai ATM (Bank -> Kas) atau setor tunai (Kas -> Bank). Sengaja model terpisah dari
// Transaction (bukan overload type="transfer") karena butuh 2 accountId sekaligus (sumber +
// tujuan), beda bentuk dari Transaction yang cuma 1 accountId + kategori. Draft -> Posted ->
// (Voided) sama persis polanya dengan Transaction — jurnal dibuat draft bareng record ini,
// baru berlaku (masuk saldo/laporan) begitu di-posting.
model AccountTransfer {
  id                    String   @id @default(uuid())
  // Nomor bukti — BPB/{tahun}/{5 digit urut}, sama pola dengan BKK/BKM (transaction-number.ts).
  transferNumber        String?  @unique @map("transfer_number")
  sourceAccountId       String   @map("source_account_id")
  destinationAccountId  String   @map("destination_account_id")
  amount                Float
  description           String?
  occurredAt            DateTime @default(now()) @map("occurred_at")
  createdAt             DateTime @default(now()) @map("created_at")

  postStatus String    @default("draft") @map("post_status") // "draft" | "posted" | "voided"
  postedAt   DateTime? @map("posted_at")
  postedById String?   @map("posted_by_id")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidReason String?   @map("void_reason")

  // Sama pola dengan Transaction.journalEntryId — link presisi ke JournalEntry yang dibuat
  // bareng record ini, bukan lookup by sourceType+sourceId.
  journalEntryId String? @unique @map("journal_entry_id")

  sourceAccount      Account      @relation("AccountTransferSource", fields: [sourceAccountId], references: [id])
  destinationAccount Account      @relation("AccountTransferDestination", fields: [destinationAccountId], references: [id])
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@map("account_transfers")
  @@schema("simple_system")
}

model Settings {
  id                String   @id @default("default")
  operasionalPct    Float    @default(40) @map("operasional_pct")
  direksiPct        Float    @default(50) @map("direksi_pct")
  bonusPct          Float    @default(10) @map("bonus_pct")
  defaultPpnRate    Float    @default(11) @map("default_ppn_rate")
  aiFollowUpEnabled Boolean  @default(false) @map("ai_follow_up_enabled")

  // Rekening tujuan transfer yang dicetak di Nota Invoice — beda rekening tergantung invoice-nya
  // pakai PPN atau tidak (lihat "Payment To" di format nota lama).
  paymentBankNamePpn       String? @map("payment_bank_name_ppn")
  paymentAccountNamePpn    String? @map("payment_account_name_ppn")
  paymentAccountNumberPpn  String? @map("payment_account_number_ppn")
  paymentBankNameNonPpn      String? @map("payment_bank_name_non_ppn")
  paymentAccountNameNonPpn   String? @map("payment_account_name_non_ppn")
  paymentAccountNumberNonPpn String? @map("payment_account_number_non_ppn")

  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("settings")
  @@schema("simple_system")
}

model FollowUp {
  id           String   @id @default(uuid())
  subject      String
  note         String
  followUpDate DateTime @map("follow_up_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("follow_ups")
  @@schema("simple_system")
}

// ---------------------------------------------------------------------------
// AI Agent (Fase 4)
// ---------------------------------------------------------------------------

model WhatsappThread {
  id         String   @id @default(uuid())
  senderType String   @map("sender_type") // "staff" | "client"
  userId     String?  @map("user_id")
  clientId   String?  @map("client_id")
  history    Json
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([senderType, userId])
  @@unique([senderType, clientId])
  @@map("whatsapp_threads")
  @@schema("simple_system")
}

model AgentRun {
  id          String   @id @default(uuid())
  actorType   String   @map("actor_type") // "staff" | "client"
  actorId     String   @map("actor_id")
  command     String
  agentAction String   @map("agent_action")
  result      String?
  status      String   @default("success")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("agent_runs")
  @@schema("simple_system")
}

/// Log khusus tiap kali AI Agent menonaktifkan domain/server/biaya berkala lewat WA — supaya
/// gampang diaudit siapa nonaktifin apa, terpisah dari AgentRun yang isinya semua jenis aksi.
model DeactivationLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") // "domain" | "server" | "recurring_bill"
  entityName String   @map("entity_name")
  actorId    String   @map("actor_id") // User.id kalau staf terdaftar, kalau tidak nomor WA mentah
  actorName  String   @map("actor_name")
  reason     String // alasan nonaktif, wajib diisi pengguna sebelum tool dieksekusi
  command    String // pesan asli yang memicu aksi ini
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("deactivation_logs")
  @@schema("simple_system")
}
